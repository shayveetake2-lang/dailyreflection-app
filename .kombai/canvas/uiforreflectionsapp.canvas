    "var_6c52a9248a3f": {
      "type": "variant",
      "label": "Weatherline — Daily Reflection Concept",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 866,
        "y": 334,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Afacad+Flux:wdth,wght@75..100,400..700&family=Literata:opsz,wght@7..72,400..600&display=swap');\n\n  .weatherline-app {\n    --paper: #E7ECE8;\n    --ink: #202923;\n    --blue: #687B84;\n    --moss: #68755F;\n    --gold: #D69A32;\n    --muted: #59635E;\n    --line: rgba(89, 99, 94, .30);\n    --line-soft: rgba(89, 99, 94, .18);\n    background: var(--paper);\n    color: var(--ink);\n    font-family: 'Afacad Flux', sans-serif;\n  }\n\n  .weatherline-app[data-mood='drained'] { --paper: #E8EDEB; }\n  .weatherline-app[data-mood='low'] { --paper: #E7ECEB; }\n  .weatherline-app[data-mood='steady'] { --paper: #E7ECE8; }\n  .weatherline-app[data-mood='light'] { --paper: #E9EDE6; }\n  .weatherline-app[data-mood='energized'] { --paper: #ECEEE3; }\n\n  .weatherline-rule {\n    transform: rotate(-6deg);\n    transform-origin: center;\n  }\n\n  .mood-point {\n    transition: color 160ms ease, transform 160ms ease;\n  }\n\n  .mood-shape {\n    width: 14px;\n    height: 14px;\n    display: block;\n    flex: none;\n    border: 2px solid var(--ink);\n    transition: width 160ms ease, height 160ms ease, outline-color 160ms ease;\n  }\n\n  .mood-point.is-selected .mood-shape {\n    width: 17px;\n    height: 17px;\n    outline: 1px solid var(--ink);\n    outline-offset: 3px;\n  }\n\n  .mood-point.is-selected .mood-label {\n    color: var(--ink);\n    font-weight: 600;\n  }\n\n  .shape-square {\n    background: var(--blue);\n    border-radius: 2px;\n  }\n\n  .shape-diamond {\n    background: var(--blue);\n    border-radius: 1px;\n    transform: rotate(45deg);\n  }\n\n  .shape-circle {\n    background: var(--moss);\n    border-radius: 999px;\n  }\n\n  .shape-triangle {\n    background: var(--gold);\n    border: 0;\n    clip-path: polygon(50% 0, 100% 100%, 0 100%);\n  }\n\n  .shape-ring {\n    background: transparent;\n    border-color: var(--gold);\n    border-radius: 999px;\n  }\n\n  .journal-copy,\n  .journal-field {\n    font-family: 'Literata', serif;\n  }\n\n  .journal-field::placeholder {\n    color: var(--muted);\n    opacity: .76;\n  }\n\n  .plot-dot {\n    transform: translate(-50%, -50%);\n  }\n\n  .plot-dot.is-missing {\n    display: none;\n  }\n\n  .switch-track {\n    background: var(--moss);\n  }\n\n  .switch-track.is-off {\n    background: var(--muted);\n  }\n\n  .switch-knob {\n    transform: translateX(18px);\n    transition: transform 160ms ease;\n  }\n\n  .switch-track.is-off .switch-knob {\n    transform: translateX(2px);\n  }\n\n  .bottom-nav .nav-item {\n    position: relative;\n  }\n\n  .bottom-nav .nav-item.is-active::after {\n    content: '';\n    position: absolute;\n    left: 25%;\n    right: 25%;\n    bottom: 8px;\n    border-bottom: 2px solid var(--ink);\n    transform: rotate(-6deg);\n  }\n</style>\n<link data-kid=\"1\" data-name=\"font awesome stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<main class=\"weatherline-app min-h-screen w-full max-w-[375px] mx-auto overflow-x-clip pb-[82px]\" data-kid=\"2\" data-mood=\"steady\" data-name=\"main app container\">\n    <div class=\"px-5 pt-5\" data-kid=\"2-1\" data-name=\"main content layout\">\n        <header class=\"flex items-start justify-between border-b border-[var(--line)] pb-4\" data-kid=\"2-1-1\" data-name=\"header section\">\n            <div data-kid=\"2-1-1-1\" data-name=\"header text group\">\n                <p class=\"text-[10px] uppercase tracking-[0.18em] text-[var(--muted)]\" data-kid=\"2-1-1-1-1\" data-name=\"today label\">\n                    Today\n                </p>\n                <h1 class=\"mt-1 text-[21px] font-medium leading-[1.08] tracking-[-0.02em]\" data-kid=\"2-1-1-1-2\" data-name=\"date heading\">\n                    Tuesday, September 1\n                </h1>\n            </div>\n            <button aria-label=\"View your calendar history\" class=\"group text-right leading-none\" data-kid=\"2-1-1-2\" data-name=\"calendar history button\" id=\"streak-link\" type=\"button\">\n                <span class=\"block text-[16px] font-semibold tabular-nums\" data-kid=\"2-1-1-2-1\" data-name=\"streak days count\">\n                    6 days\n                </span>\n                <span class=\"mt-1 block text-[12px] text-[var(--muted)]\" data-kid=\"2-1-1-2-2\" data-name=\"streak suffix label\">\n                    in a row\n                </span>\n            </button>\n        </header>\n        <button aria-label=\"Weekly check-in ruler, five of seven days recorded\" class=\"mt-3 block w-full border-b border-[var(--line-soft)] pb-3 text-left\" data-kid=\"2-1-2\" data-name=\"weekly check-in ruler\" id=\"week-ruler\" type=\"button\">\n            <span class=\"flex items-center justify-between text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]\" data-kid=\"2-1-2-1\" data-name=\"ruler label row\">\n                <span data-kid=\"2-1-2-1-1\" data-name=\"week title\">\n                    This week\n                </span>\n                <span data-kid=\"2-1-2-1-2\" data-name=\"records count\">\n                    5 recorded\n                </span>\n            </span>\n            <span class=\"relative mt-2 grid grid-cols-7 gap-2\" data-kid=\"2-1-2-2\" data-name=\"ruler grid container\">\n                <span class=\"absolute left-0 right-0 top-[19px] border-t border-[var(--line-soft)]\" data-kid=\"2-1-2-2-1\" data-name=\"ruler timeline divider line\">\n                </span>\n                <span class=\"relative flex flex-col items-center gap-2 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2\" data-name=\"monday column\">\n                    <span data-kid=\"2-1-2-2-2-1\" data-name=\"monday label\">\n                        M\n                    </span>\n                    <i class=\"block h-[11px] w-px bg-[var(--moss)]\" data-kid=\"2-1-2-2-2-2\" data-name=\"monday status icon\">\n                    </i>\n                </span>\n                <span class=\"relative flex flex-col items-center gap-2 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-3\" data-name=\"tuesday column\">\n                    <span data-kid=\"2-1-2-2-3-1\" data-name=\"tuesday label\">\n                        T\n                    </span>\n                    <i class=\"block h-[11px] w-px bg-[var(--moss)]\" data-kid=\"2-1-2-2-3-2\" data-name=\"tuesday status icon\">\n                    </i>\n                </span>\n                <span class=\"relative flex flex-col items-center gap-2 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-4\" data-name=\"wednesday column\">\n                    <span data-kid=\"2-1-2-2-4-1\" data-name=\"wednesday label\">\n                        W\n                    </span>\n                    <i class=\"block h-[11px] w-px bg-[var(--moss)]\" data-kid=\"2-1-2-2-4-2\" data-name=\"wednesday status icon\">\n                    </i>\n                </span>\n                <span class=\"relative flex flex-col items-center gap-2 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-5\" data-name=\"thursday column\">\n                    <span data-kid=\"2-1-2-2-5-1\" data-name=\"thursday label\">\n                        T\n                    </span>\n                    <i class=\"block h-[11px] w-px bg-[var(--moss)]\" data-kid=\"2-1-2-2-5-2\" data-name=\"thursday status icon\">\n                    </i>\n                </span>\n                <span class=\"relative flex flex-col items-center gap-2 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-6\" data-name=\"friday column\">\n                    <span data-kid=\"2-1-2-2-6-1\" data-name=\"friday label\">\n                        F\n                    </span>\n                    <i class=\"block h-[11px] w-px bg-[var(--moss)]\" data-kid=\"2-1-2-2-6-2\" data-name=\"friday status icon\">\n                    </i>\n                </span>\n                <span class=\"relative flex flex-col items-center gap-2 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-7\" data-name=\"saturday column\">\n                    <span data-kid=\"2-1-2-2-7-1\" data-name=\"saturday label\">\n                        S\n                    </span>\n                    <i class=\"block h-[11px] w-px bg-[var(--gold)]\" data-kid=\"2-1-2-2-7-2\" data-name=\"saturday status icon\">\n                    </i>\n                </span>\n                <span class=\"relative flex flex-col items-center gap-2 text-[10px] text-[var(--muted)]\" data-kid=\"2-1-2-2-8\" data-name=\"sunday column\">\n                    <span data-kid=\"2-1-2-2-8-1\" data-name=\"sunday label\">\n                        S\n                    </span>\n                    <i class=\"block h-[11px] border-l border-dashed border-[var(--muted)]\" data-kid=\"2-1-2-2-8-2\" data-name=\"sunday status icon\">\n                    </i>\n                </span>\n            </span>\n        </button>\n        <section aria-labelledby=\"mood-heading\" class=\"mt-7\" data-kid=\"2-1-3\" data-name=\"mood check-in section\">\n            <div class=\"flex items-end justify-between gap-3\" data-kid=\"2-1-3-1\" data-name=\"mood section header group\">\n                <h2 class=\"text-[25px] font-medium leading-[1.05] tracking-[-0.03em]\" data-kid=\"2-1-3-1-1\" data-name=\"mood heading\" id=\"mood-heading\">\n                    How are you feeling?\n                </h2>\n                <p aria-live=\"polite\" class=\"mb-0.5 min-w-[92px] text-right text-[11px] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2\" data-name=\"mood status confirmation text\" data-reason=\"text updated via script on mood button click\" id=\"mood-confirmation\">\n                    Feeling steady.\n                </p>\n            </div>\n            <div aria-label=\"Mood check-in scale\" class=\"relative mt-2 h-[159px]\" data-kid=\"2-1-3-2\" data-name=\"mood scale container\">\n                <div class=\"weatherline-rule pointer-events-none absolute left-0 right-0 top-[83px] flex h-[2px]\" data-kid=\"2-1-3-2-1\" data-name=\"mood scale background rule\">\n                    <span class=\"w-[39%] bg-[var(--blue)]\" data-kid=\"2-1-3-2-1-1\" data-name=\"scale color segment 1\">\n                    </span>\n                    <span class=\"w-[31%] bg-[var(--moss)]\" data-kid=\"2-1-3-2-1-2\" data-name=\"scale color segment 2\">\n                    </span>\n                    <span class=\"w-[30%] bg-[var(--gold)]\" data-kid=\"2-1-3-2-1-3\" data-name=\"scale color segment 3\">\n                    </span>\n                </div>\n                <button aria-pressed=\"false\" class=\"mood-point absolute left-[7%] top-[93px] flex w-[62px] -translate-x-1/2 flex-col items-center gap-[9px] border-0 bg-transparent p-0 text-[11px] text-[var(--muted)]\" data-kid=\"2-1-3-2-2\" data-mood=\"drained\" data-name=\"drained mood button\" type=\"button\">\n                    <span class=\"mood-shape shape-square\" data-kid=\"2-1-3-2-2-1\" data-name=\"drained icon\">\n                    </span>\n                    <span class=\"mood-label\" data-kid=\"2-1-3-2-2-2\" data-name=\"drained label\">\n                        Drained\n                    </span>\n                </button>\n                <button aria-pressed=\"false\" class=\"mood-point absolute left-[28.5%] top-[84px] flex w-[62px] -translate-x-1/2 flex-col items-center gap-[9px] border-0 bg-transparent p-0 text-[11px] text-[var(--muted)]\" data-kid=\"2-1-3-2-3\" data-mood=\"low\" data-name=\"low mood button\" type=\"button\">\n                    <span class=\"mood-shape shape-diamond\" data-kid=\"2-1-3-2-3-1\" data-name=\"low icon\">\n                    </span>\n                    <span class=\"mood-label\" data-kid=\"2-1-3-2-3-2\" data-name=\"low label\">\n                        Low\n                    </span>\n                </button>\n                <button aria-pressed=\"true\" class=\"mood-point is-selected absolute left-[50%] top-[77px] flex w-[62px] -translate-x-1/2 flex-col items-center gap-[9px] border-0 bg-transparent p-0 text-[11px] text-[var(--muted)]\" data-kid=\"2-1-3-2-4\" data-mood=\"steady\" data-name=\"steady mood button\" type=\"button\">\n                    <span class=\"mood-shape shape-circle\" data-kid=\"2-1-3-2-4-1\" data-name=\"steady icon\">\n                    </span>\n                    <span class=\"mood-label\" data-kid=\"2-1-3-2-4-2\" data-name=\"steady label\">\n                        Steady\n                    </span>\n                </button>\n                <button aria-pressed=\"false\" class=\"mood-point absolute left-[71.5%] top-[70px] flex w-[62px] -translate-x-1/2 flex-col items-center gap-[9px] border-0 bg-transparent p-0 text-[11px] text-[var(--muted)]\" data-kid=\"2-1-3-2-5\" data-mood=\"light\" data-name=\"light mood button\" type=\"button\">\n                    <span class=\"mood-shape shape-triangle\" data-kid=\"2-1-3-2-5-1\" data-name=\"light icon\">\n                    </span>\n                    <span class=\"mood-label\" data-kid=\"2-1-3-2-5-2\" data-name=\"light label\">\n                        Light\n                    </span>\n                </button>\n                <button aria-pressed=\"false\" class=\"mood-point absolute left-[93%] top-[62px] flex w-[67px] -translate-x-1/2 flex-col items-center gap-[9px] border-0 bg-transparent p-0 text-[11px] text-[var(--muted)]\" data-kid=\"2-1-3-2-6\" data-mood=\"energized\" data-name=\"energized mood button\" type=\"button\">\n                    <span class=\"mood-shape shape-ring\" data-kid=\"2-1-3-2-6-1\" data-name=\"energized icon\">\n                    </span>\n                    <span class=\"mood-label\" data-kid=\"2-1-3-2-6-2\" data-name=\"energized label\">\n                        Energized\n                    </span>\n                </button>\n            </div>\n            <p class=\"mt-0 text-[11px] text-[var(--muted)]\" data-kid=\"2-1-3-3\" data-name=\"mood instruction text\">\n                Tap a point to check in.\n            </p>\n        </section>\n        <section aria-labelledby=\"journal-heading\" class=\"mt-8 border-t border-[var(--line)] pt-5\" data-kid=\"2-1-4\" data-name=\"journal reflection section\">\n            <p class=\"text-[10px] uppercase tracking-[0.17em] text-[var(--muted)]\" data-kid=\"2-1-4-1\" data-name=\"reflect header\">\n                Reflect\n            </p>\n            <div class=\"mt-3 border-l-2 border-[var(--gold)] pl-4\" data-kid=\"2-1-4-2\" data-name=\"journal input group\">\n                <h2 class=\"journal-copy max-w-[310px] text-[21px] leading-[1.35] tracking-[-0.02em]\" data-kid=\"2-1-4-2-1\" data-name=\"journal prompt heading\" id=\"journal-heading\">\n                    What took more energy than you expected today?\n                </h2>\n                <textarea aria-label=\"Write your reflection\" class=\"journal-field mt-4 min-h-[116px] w-full resize-none border-0 bg-transparent p-0 text-[17px] leading-[1.72] text-[var(--ink)] outline-hidden\" data-kid=\"2-1-4-2-2\" data-name=\"journal text area\" placeholder=\"Write what comes to mind…\"></textarea>\n                <div class=\"flex items-center justify-between border-t border-[var(--line-soft)] pt-3 text-[12px] text-[var(--muted)]\" data-kid=\"2-1-4-2-3\" data-name=\"reflection status row\">\n                    <span data-dynamic=\"true\" data-kid=\"2-1-4-2-3-1\" data-name=\"autosave status text\" data-reason=\"text updated via script on save button click\" id=\"autosave-copy\">\n                        Saved automatically\n                    </span>\n                    <span class=\"tabular-nums\" data-kid=\"2-1-4-2-3-2\" data-name=\"timestamp\">\n                        Today · 8:30 PM\n                    </span>\n                </div>\n            </div>\n            <button class=\"mt-4 h-11 w-full rounded-[8px] bg-[var(--ink)] px-4 text-[15px] font-semibold text-[var(--paper)]\" data-dynamic=\"true\" data-kid=\"2-1-4-3\" data-name=\"save reflection button\" data-reason=\"text and aria label updated by script on click\" id=\"save-reflection\" type=\"button\">\n                Save reflection\n            </button>\n        </section>\n        <section aria-labelledby=\"calendar-heading\" class=\"mt-10 border-t border-[var(--line)] pt-5\" data-kid=\"2-1-5\" data-name=\"calendar history section\">\n            <div class=\"flex items-center gap-2\" data-kid=\"2-1-5-1\" data-name=\"calendar header group\">\n                <i aria-hidden=\"true\" class=\"ti ti-calendar-month text-[18px] leading-none text-[var(--muted)]\" data-kid=\"2-1-5-1-1\" data-name=\"calendar icon\" style=\"color:var(--muted);width:18px;height:18px\">\n                </i>\n                <h2 class=\"text-[19px] font-semibold leading-none\" data-kid=\"2-1-5-1-2\" data-name=\"calendar section title\" id=\"calendar-heading\">\n                    Calendar history\n                </h2>\n                <span class=\"ml-auto text-[12px] text-[var(--muted)]\" data-kid=\"2-1-5-1-3\" data-name=\"month label\">\n                    September\n                </span>\n            </div>\n            <div class=\"mt-4 grid grid-cols-7 text-center text-[10px] uppercase tracking-[0.12em] text-[var(--muted)]\" data-kid=\"2-1-5-2\" data-name=\"calendar weekday labels\">\n                <span data-kid=\"2-1-5-2-1\" data-name=\"calendar monday label\">\n                    M\n                </span>\n                <span data-kid=\"2-1-5-2-2\" data-name=\"calendar tuesday label\">\n                    T\n                </span>\n                <span data-kid=\"2-1-5-2-3\" data-name=\"calendar wednesday label\">\n                    W\n                </span>\n                <span data-kid=\"2-1-5-2-4\" data-name=\"calendar thursday label\">\n                    T\n                </span>\n                <span data-kid=\"2-1-5-2-5\" data-name=\"calendar friday label\">\n                    F\n                </span>\n                <span data-kid=\"2-1-5-2-6\" data-name=\"calendar saturday label\">\n                    S\n                </span>\n                <span data-kid=\"2-1-5-2-7\" data-name=\"calendar sunday label\">\n                    S\n                </span>\n            </div>\n            <div class=\"mt-2 grid grid-cols-7 gap-x-1 gap-y-1 text-center text-[11px] tabular-nums\" data-kid=\"2-1-5-3\" data-name=\"calendar grid\">\n                <span class=\"h-[39px] border-b border-[var(--line-soft)]\" data-kid=\"2-1-5-3-1\" data-name=\"calendar empty start day 1\">\n                </span>\n                <button aria-label=\"September 1, steady check-in with writing\" class=\"relative flex h-[39px] flex-col items-center border-b-2 border-[var(--ink)] pt-1 text-[var(--ink)]\" data-kid=\"2-1-5-3-2\" data-name=\"day 1 button\" type=\"button\">\n                    1\n                    <span class=\"mt-2 h-[7px] w-[7px] rounded-full bg-[var(--moss)]\" data-kid=\"2-1-5-3-2-1\" data-name=\"day 1 icon\">\n                    </span>\n                    <span class=\"absolute bottom-[3px] h-[2px] w-3 bg-[var(--ink)]\" data-kid=\"2-1-5-3-2-2\" data-name=\"day 1 underline\">\n                    </span>\n                </button>\n                <button aria-label=\"September 2, light check-in with writing\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1\" data-kid=\"2-1-5-3-3\" data-name=\"day 2 button\" type=\"button\">\n                    2\n                    <span class=\"mt-2 h-[7px] w-[7px] rounded-full bg-[var(--gold)]\" data-kid=\"2-1-5-3-3-1\" data-name=\"day 2 icon\">\n                    </span>\n                    <span class=\"absolute bottom-[3px] h-[2px] w-3 bg-[var(--ink)]\" data-kid=\"2-1-5-3-3-2\" data-name=\"day 2 underline\">\n                    </span>\n                </button>\n                <button aria-label=\"September 3, steady check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1\" data-kid=\"2-1-5-3-4\" data-name=\"day 3 button\" type=\"button\">\n                    3\n                    <span class=\"mt-2 h-[7px] w-[7px] rounded-full bg-[var(--moss)]\" data-kid=\"2-1-5-3-4-1\" data-name=\"day 3 icon\">\n                    </span>\n                </button>\n                <button aria-label=\"September 4, low check-in with writing\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1\" data-kid=\"2-1-5-3-5\" data-name=\"day 4 button\" type=\"button\">\n                    4\n                    <span class=\"mt-2 h-[7px] w-[7px] rounded-sm bg-[var(--blue)]\" data-kid=\"2-1-5-3-5-1\" data-name=\"day 4 icon\">\n                    </span>\n                    <span class=\"absolute bottom-[3px] h-[2px] w-3 bg-[var(--ink)]\" data-kid=\"2-1-5-3-5-2\" data-name=\"day 4 underline\">\n                    </span>\n                </button>\n                <button aria-label=\"September 5, light check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1\" data-kid=\"2-1-5-3-6\" data-name=\"day 5 button\" type=\"button\">\n                    5\n                    <span class=\"mt-2 h-[7px] w-[7px] rounded-full bg-[var(--gold)]\" data-kid=\"2-1-5-3-6-1\" data-name=\"day 5 icon\">\n                    </span>\n                </button>\n                <button aria-label=\"September 6, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-7\" data-name=\"day 6 button\" type=\"button\">\n                    6\n                </button>\n                <button aria-label=\"September 7, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-8\" data-name=\"day 7 button\" type=\"button\">\n                    7\n                </button>\n                <button aria-label=\"September 8, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-9\" data-name=\"day 8 button\" type=\"button\">\n                    8\n                </button>\n                <button aria-label=\"September 9, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-10\" data-name=\"day 9 button\" type=\"button\">\n                    9\n                </button>\n                <button aria-label=\"September 10, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-11\" data-name=\"day 10 button\" type=\"button\">\n                    10\n                </button>\n                <button aria-label=\"September 11, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-12\" data-name=\"day 11 button\" type=\"button\">\n                    11\n                </button>\n                <button aria-label=\"September 12, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-13\" data-name=\"day 12 button\" type=\"button\">\n                    12\n                </button>\n                <button aria-label=\"September 13, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-14\" data-name=\"day 13 button\" type=\"button\">\n                    13\n                </button>\n                <button aria-label=\"September 14, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-15\" data-name=\"day 14 button\" type=\"button\">\n                    14\n                </button>\n                <button aria-label=\"September 15, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-16\" data-name=\"day 15 button\" type=\"button\">\n                    15\n                </button>\n                <button aria-label=\"September 16, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-17\" data-name=\"day 16 button\" type=\"button\">\n                    16\n                </button>\n                <button aria-label=\"September 17, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-18\" data-name=\"day 17 button\" type=\"button\">\n                    17\n                </button>\n                <button aria-label=\"September 18, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-19\" data-name=\"day 18 button\" type=\"button\">\n                    18\n                </button>\n                <button aria-label=\"September 19, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-20\" data-name=\"day 19 button\" type=\"button\">\n                    19\n                </button>\n                <button aria-label=\"September 20, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-21\" data-name=\"day 20 button\" type=\"button\">\n                    20\n                </button>\n                <button aria-label=\"September 21, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-22\" data-name=\"day 21 button\" type=\"button\">\n                    21\n                </button>\n                <button aria-label=\"September 22, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-23\" data-name=\"day 22 button\" type=\"button\">\n                    22\n                </button>\n                <button aria-label=\"September 23, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-24\" data-name=\"day 23 button\" type=\"button\">\n                    23\n                </button>\n                <button aria-label=\"September 24, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-25\" data-name=\"day 24 button\" type=\"button\">\n                    24\n                </button>\n                <button aria-label=\"September 25, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-26\" data-name=\"day 25 button\" type=\"button\">\n                    25\n                </button>\n                <button aria-label=\"September 26, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-27\" data-name=\"day 26 button\" type=\"button\">\n                    26\n                </button>\n                <button aria-label=\"September 27, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-28\" data-name=\"day 27 button\" type=\"button\">\n                    27\n                </button>\n                <button aria-label=\"September 28, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-29\" data-name=\"day 28 button\" type=\"button\">\n                    28\n                </button>\n                <button aria-label=\"September 29, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-30\" data-name=\"day 29 button\" type=\"button\">\n                    29\n                </button>\n                <button aria-label=\"September 30, no check-in\" class=\"relative flex h-[39px] flex-col items-center border-b border-[var(--line-soft)] pt-1 text-[var(--muted)]\" data-kid=\"2-1-5-3-31\" data-name=\"day 30 button\" type=\"button\">\n                    30\n                </button>\n                <span class=\"h-[39px] border-b border-[var(--line-soft)]\" data-kid=\"2-1-5-3-32\" data-name=\"calendar empty end day 1\">\n                </span>\n                <span class=\"h-[39px] border-b border-[var(--line-soft)]\" data-kid=\"2-1-5-3-33\" data-name=\"calendar empty end day 2\">\n                </span>\n                <span class=\"h-[39px] border-b border-[var(--line-soft)]\" data-kid=\"2-1-5-3-34\" data-name=\"calendar empty end day 3\">\n                </span>\n                <span class=\"h-[39px] border-b border-[var(--line-soft)]\" data-kid=\"2-1-5-3-35\" data-name=\"calendar empty end day 4\">\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"patterns-heading\" class=\"mt-10 border-t border-[var(--line)] pt-5\" data-kid=\"2-1-6\" data-name=\"patterns section\">\n            <div class=\"flex items-center justify-between\" data-kid=\"2-1-6-1\" data-name=\"patterns header group\">\n                <h2 class=\"text-[19px] font-semibold leading-none\" data-kid=\"2-1-6-1-1\" data-name=\"patterns section title\" id=\"patterns-heading\">\n                    Patterns\n                </h2>\n                <span class=\"text-[10px] uppercase tracking-[0.15em] text-[var(--muted)]\" data-kid=\"2-1-6-1-2\" data-name=\"patterns timeframe label\">\n                    This week\n                </span>\n            </div>\n            <p class=\"journal-copy mt-3 max-w-[305px] text-[18px] leading-[1.4] tracking-[-0.015em]\" data-kid=\"2-1-6-2\" data-name=\"patterns summary text\">\n                Steady was your most common check-in this week.\n            </p>\n            <div aria-label=\"Seven-day labeled mood dot plot. Five of seven days recorded.\" class=\"mt-5 grid grid-cols-[57px_1fr] gap-2\" data-kid=\"2-1-6-3\" data-name=\"patterns plot area\" role=\"img\">\n                <div class=\"flex h-[132px] flex-col justify-between text-[9px] leading-none text-[var(--muted)]\" data-kid=\"2-1-6-3-1\" data-name=\"patterns y-axis labels\">\n                    <span data-kid=\"2-1-6-3-1-1\" data-name=\"patterns y-axis label 1\">\n                        Energized\n                    </span>\n                    <span data-kid=\"2-1-6-3-1-2\" data-name=\"patterns y-axis label 2\">\n                        Light\n                    </span>\n                    <span data-kid=\"2-1-6-3-1-3\" data-name=\"patterns y-axis label 3\">\n                        Steady\n                    </span>\n                    <span data-kid=\"2-1-6-3-1-4\" data-name=\"patterns y-axis label 4\">\n                        Low\n                    </span>\n                    <span data-kid=\"2-1-6-3-1-5\" data-name=\"patterns y-axis label 5\">\n                        Drained\n                    </span>\n                </div>\n                <div data-kid=\"2-1-6-3-2\" data-name=\"patterns chart area\">\n                    <div class=\"relative h-[132px]\" data-kid=\"2-1-6-3-2-1\" data-name=\"patterns chart grid\">\n                        <div class=\"absolute inset-0 flex flex-col justify-between\" data-kid=\"2-1-6-3-2-1-1\" data-name=\"grid lines container\">\n                            <span class=\"border-t border-[var(--line-soft)]\" data-kid=\"2-1-6-3-2-1-1-1\" data-name=\"grid line 1\">\n                            </span>\n                            <span class=\"border-t border-[var(--line-soft)]\" data-kid=\"2-1-6-3-2-1-1-2\" data-name=\"grid line 2\">\n                            </span>\n                            <span class=\"border-t border-[var(--line-soft)]\" data-kid=\"2-1-6-3-2-1-1-3\" data-name=\"grid line 3\">\n                            </span>\n                            <span class=\"border-t border-[var(--line-soft)]\" data-kid=\"2-1-6-3-2-1-1-4\" data-name=\"grid line 4\">\n                            </span>\n                            <span class=\"border-t border-[var(--line-soft)]\" data-kid=\"2-1-6-3-2-1-1-5\" data-name=\"grid line 5\">\n                            </span>\n                        </div>\n                        <span class=\"plot-dot absolute left-[8%] top-[50%] h-[10px] w-[10px] rounded-full border-2 border-[var(--paper)] bg-[var(--moss)]\" data-kid=\"2-1-6-3-2-1-2\" data-name=\"data point 1\">\n                        </span>\n                        <span class=\"plot-dot absolute left-[25%] top-[27%] h-[10px] w-[10px] rounded-full border-2 border-[var(--paper)] bg-[var(--gold)]\" data-kid=\"2-1-6-3-2-1-3\" data-name=\"data point 2\">\n                        </span>\n                        <span class=\"plot-dot absolute left-[42%] top-[50%] h-[10px] w-[10px] rounded-full border-2 border-[var(--paper)] bg-[var(--moss)]\" data-kid=\"2-1-6-3-2-1-4\" data-name=\"data point 3\">\n                        </span>\n                        <span class=\"plot-dot absolute left-[59%] top-[73%] h-[10px] w-[10px] rounded-sm border-2 border-[var(--paper)] bg-[var(--blue)]\" data-kid=\"2-1-6-3-2-1-5\" data-name=\"data point 4\">\n                        </span>\n                        <span class=\"plot-dot absolute left-[76%] top-[50%] h-[10px] w-[10px] rounded-full border-2 border-[var(--paper)] bg-[var(--moss)]\" data-kid=\"2-1-6-3-2-1-6\" data-name=\"data point 5\">\n                        </span>\n                        <span class=\"plot-dot is-missing absolute left-[91%] top-[50%] h-[10px] w-[10px] rounded-full border-2 border-[var(--paper)] bg-[var(--muted)]\" data-kid=\"2-1-6-3-2-1-7\" data-name=\"data point 6\">\n                        </span>\n                    </div>\n                    <div class=\"mt-2 grid grid-cols-7 text-center text-[10px] text-[var(--muted)]\" data-kid=\"2-1-6-3-2-2\" data-name=\"patterns x-axis labels\">\n                        <span data-kid=\"2-1-6-3-2-2-1\" data-name=\"x-axis label 1\">\n                            Mon\n                        </span>\n                        <span data-kid=\"2-1-6-3-2-2-2\" data-name=\"x-axis label 2\">\n                            Tue\n                        </span>\n                        <span data-kid=\"2-1-6-3-2-2-3\" data-name=\"x-axis label 3\">\n                            Wed\n                        </span>\n                        <span data-kid=\"2-1-6-3-2-2-4\" data-name=\"x-axis label 4\">\n                            Thu\n                        </span>\n                        <span data-kid=\"2-1-6-3-2-2-5\" data-name=\"x-axis label 5\">\n                            Fri\n                        </span>\n                        <span data-kid=\"2-1-6-3-2-2-6\" data-name=\"x-axis label 6\">\n                            Sat\n                        </span>\n                        <span data-kid=\"2-1-6-3-2-2-7\" data-name=\"x-axis label 7\">\n                            Sun\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <p class=\"mt-3 text-[12px] text-[var(--muted)]\" data-kid=\"2-1-6-4\" data-name=\"patterns footer text\">\n                5 of 7 days recorded.\n            </p>\n        </section>\n        <section aria-labelledby=\"reminder-heading\" class=\"mt-10 border-t border-[var(--line)] pt-5\" data-kid=\"2-1-7\" data-name=\"reminder section\">\n            <div class=\"flex items-center gap-2\" data-kid=\"2-1-7-1\" data-name=\"reminder header group\">\n                <i aria-hidden=\"true\" class=\"ti ti-bell text-[18px] leading-none text-[var(--muted)]\" data-kid=\"2-1-7-1-1\" data-name=\"reminder icon\" style=\"color:var(--muted);width:18px;height:18px\">\n                </i>\n                <h2 class=\"text-[19px] font-semibold leading-none\" data-kid=\"2-1-7-1-2\" data-name=\"reminder section title\" id=\"reminder-heading\">\n                    Reminder\n                </h2>\n            </div>\n            <div class=\"mt-3 flex items-center justify-between border-b border-[var(--line)] py-3\" data-kid=\"2-1-7-2\" data-name=\"reminder setting row\">\n                <div data-kid=\"2-1-7-2-1\" data-name=\"reminder label group\">\n                    <p class=\"text-[16px] leading-none\" data-kid=\"2-1-7-2-1-1\" data-name=\"reminder label title\">\n                        Daily reminder\n                    </p>\n                    <p class=\"mt-2 text-[12px] text-[var(--muted)]\" data-kid=\"2-1-7-2-1-2\" data-name=\"reminder timing group\">\n                        <span class=\"uppercase tracking-[0.12em]\" data-kid=\"2-1-7-2-1-2-1\" data-name=\"reminder time label\">\n                            Time\n                        </span>\n                        <span class=\"mx-1\" data-kid=\"2-1-7-2-1-2-2\" data-name=\"reminder separator\">\n                            ·\n                        </span>\n                        <span class=\"tabular-nums\" data-kid=\"2-1-7-2-1-2-3\" data-name=\"reminder time value\">\n                            8:30 PM\n                        </span>\n                    </p>\n                </div>\n                <button aria-label=\"Daily reminder on\" aria-pressed=\"true\" class=\"switch-track relative h-[22px] w-10 rounded-full border-0 p-0\" data-dynamic=\"true\" data-kid=\"2-1-7-2-2\" data-name=\"reminder toggle button\" data-reason=\"aria attributes updated by script on click\" id=\"reminder-toggle\" type=\"button\">\n                    <span class=\"switch-knob absolute left-0 top-[3px] block h-4 w-4 rounded-full bg-[var(--paper)]\" data-kid=\"2-1-7-2-2-1\" data-name=\"toggle switch knob\">\n                    </span>\n                </button>\n            </div>\n        </section>\n    </div>\n    <nav aria-label=\"Primary\" class=\"bottom-nav fixed bottom-0 left-1/2 z-30 grid h-[58px] w-full max-w-[375px] -translate-x-1/2 grid-cols-4 border-t border-[var(--line)] bg-[var(--paper)]\" data-kid=\"2-2\" data-name=\"primary navigation bar\">\n        <button aria-current=\"page\" class=\"nav-item is-active text-[12px] font-semibold text-[var(--ink)]\" data-kid=\"2-2-1\" data-name=\"today tab\" type=\"button\">\n            Today\n        </button>\n        <button class=\"nav-item text-[12px] font-medium text-[var(--muted)]\" data-kid=\"2-2-2\" data-name=\"calendar tab\" type=\"button\">\n            Calendar\n        </button>\n        <button class=\"nav-item text-[12px] font-medium text-[var(--muted)]\" data-kid=\"2-2-3\" data-name=\"patterns tab\" type=\"button\">\n            Patterns\n        </button>\n        <button class=\"nav-item text-[12px] font-medium text-[var(--muted)]\" data-kid=\"2-2-4\" data-name=\"reminder tab\" type=\"button\">\n            Reminder\n        </button>\n    </nav>\n</main>\n<script>\n    const app = document.querySelector('.weatherline-app');\n  const moodStatus = document.querySelector('#mood-confirmation');\n  const moodButtons = document.querySelectorAll('.mood-point');\n  const moodCopy = {\n    drained: 'Feeling drained.',\n    low: 'Feeling low.',\n    steady: 'Feeling steady.',\n    light: 'Feeling light.',\n    energized: 'Feeling energized.'\n  };\n\n  moodButtons.forEach((button) => {\n    button.addEventListener('click', () => {\n      const mood = button.dataset.mood;\n      moodButtons.forEach((item) => {\n        const selected = item === button;\n        item.classList.toggle('is-selected', selected);\n        item.setAttribute('aria-pressed', String(selected));\n      });\n      app.dataset.mood = mood;\n      moodStatus.textContent = moodCopy[mood];\n    });\n  });\n\n  document.querySelector('#save-reflection').addEventListener('click', (event) => {\n    event.currentTarget.textContent = 'Saved for today';\n    event.currentTarget.setAttribute('aria-label', 'Reflection saved for today');\n    document.querySelector('#autosave-copy').textContent = 'Saved automatically';\n  });\n\n  const reminderToggle = document.querySelector('#reminder-toggle');\n  reminderToggle.addEventListener('click', () => {\n    const enabled = reminderToggle.getAttribute('aria-pressed') === 'true';\n    reminderToggle.setAttribute('aria-pressed', String(!enabled));\n    reminderToggle.setAttribute('aria-label', `Daily reminder ${enabled ? 'off' : 'on'}`);\n    reminderToggle.classList.toggle('is-off', enabled);\n  });\n</script>\n",
      "comments": [],
      "created": "2026-09-01T08:01:17.757638+00:00",
      "modified": "2026-09-01T08:01:17.757638+00:00",
      "id": "var_6c52a9248a3f"
    },
    "var_d0c28c98d55a": {
      "type": "variant",
      "label": "Pocket Folio — Daily Reflection Concept",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1341,
        "y": 334,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Alegreya:wght@400;500;600;700&family=Spline+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .folio-page {\n    --paper: #F5F0E5;\n    --espresso: #2B1B16;\n    --oxblood: #7C3F49;\n    --ochre: #B48545;\n    --lichen: #717A68;\n    --edge: #DED5C5;\n    font-family: 'Spline Sans', sans-serif;\n    color: var(--espresso);\n    background: var(--paper);\n  }\n\n  .font-alegreya { font-family: 'Alegreya', serif; }\n  .font-spline { font-family: 'Spline Sans', sans-serif; }\n\n  .folio-back-one {\n    position: absolute;\n    inset: 6px -7px -6px 6px;\n    background: var(--edge);\n  }\n\n  .folio-back-two {\n    position: absolute;\n    inset: 3px -3px -3px 3px;\n    background: var(--edge);\n  }\n\n  .folio-slip {\n    position: relative;\n    background: var(--paper);\n    box-shadow: 4px 4px 0 var(--ochre);\n  }\n\n  .date-tab {\n    clip-path: polygon(0 0, 89% 0, 100% 50%, 89% 100%, 0 100%);\n    background: var(--edge);\n  }\n\n  .mood-tongue {\n    width: 102px;\n    height: 48px;\n    clip-path: polygon(0 0, 88% 0, 100% 20%, 100% 80%, 88% 100%, 0 100%, 7% 70%, 7% 30%);\n    transition: transform 160ms ease;\n  }\n\n  .mood-tongue.is-selected { transform: translateX(-14px); }\n  .mood-rail { right: -32px; }\n\n  .mood-notch {\n    display: inline-block;\n    width: 8px;\n    height: 15px;\n    flex: none;\n    border-left: 2px solid currentColor;\n  }\n\n  .mood-notch.is-dotted { border-left-style: dotted; }\n  .mood-notch.is-dashed { border-left-style: dashed; }\n  .mood-notch.is-double { border-left-style: double; border-right: 1px solid currentColor; }\n  .mood-notch.is-slanted { transform: skewY(-24deg); }\n\n  .ruled-field {\n    min-height: 132px;\n    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 31px, color-mix(in srgb, var(--espresso) 22%, transparent) 32px);\n  }\n\n  .folio-textarea::placeholder { color: var(--espresso); opacity: .62; }\n  .folio-textarea:focus { outline: none; }\n  .folio-textarea:focus + .focus-rule { background: var(--oxblood); }\n\n  .history-day { position: relative; }\n  .history-day .mood-notch-small {\n    position: absolute;\n    bottom: 10px;\n    width: 14px;\n    height: 5px;\n    clip-path: polygon(0 0, 74% 0, 100% 50%, 74% 100%, 0 100%, 18% 50%);\n  }\n  .history-day .writing-line {\n    position: absolute;\n    bottom: 5px;\n    width: 20px;\n    height: 1px;\n    background: var(--espresso);\n    opacity: .48;\n  }\n  .history-day.is-selected .writing-line { background: var(--paper); opacity: .7; }\n\n  .pattern-week {\n    display: grid;\n    grid-template-columns: 25px repeat(7, minmax(0, 1fr));\n    gap: 4px;\n  }\n\n  .pattern-cell {\n    min-width: 0;\n    height: 34px;\n    border-bottom: 1px solid var(--edge);\n  }\n\n  .pattern-mark {\n    display: block;\n    width: 14px;\n    height: 6px;\n    clip-path: polygon(0 0, 74% 0, 100% 50%, 74% 100%, 0 100%, 18% 50%);\n  }\n\n  .pattern-gap {\n    display: flex;\n    width: 14px;\n    height: 8px;\n    align-items: center;\n    justify-content: center;\n    color: var(--edge);\n    line-height: 8px;\n    transform: translateY(2px);\n  }\n\n  .pattern-writing {\n    display: block;\n    width: 18px;\n    height: 1px;\n    margin-top: 3px;\n    background: var(--espresso);\n    opacity: .45;\n  }\n\n  .folio-nav-active {\n    height: 63px;\n    transform: translateY(-3px);\n    background: var(--paper);\n    border-top: 2px solid var(--espresso);\n  }\n</style>\n<main class=\"folio-page min-h-[100dvh] overflow-x-clip pb-5\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"px-3 pb-4 pt-5\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"flex items-center justify-between border-b border-[var(--edge)] pb-4\" data-kid=\"1-1-1\" data-name=\"header top row\">\n            <p class=\"text-[11px] font-semibold uppercase tracking-[0.18em]\" data-kid=\"1-1-1-1\" data-name=\"page title breadcrumb\">\n                Pocket folio\n                <span class=\"text-[var(--oxblood)]\" data-kid=\"1-1-1-1-1\" data-name=\"separator slash\">\n                    /\n                </span>\n                Today\n            </p>\n            <p class=\"flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--lichen)]\" data-kid=\"1-1-1-2\" data-name=\"status indicator container\">\n                <span class=\"h-2 w-2 bg-[var(--oxblood)]\" data-kid=\"1-1-1-2-1\" data-name=\"status color block\">\n                </span>\n                Check in\n            </p>\n        </div>\n        <div aria-label=\"Weekly reflection progress\" class=\"flex items-center gap-3 pt-4\" data-kid=\"1-1-2\" data-name=\"weekly progress section\">\n            <div aria-hidden=\"true\" class=\"flex items-center gap-1.5\" data-kid=\"1-1-2-1\" data-name=\"progress tracker dots container\">\n                <span class=\"h-3 w-3 rounded-full bg-[var(--espresso)]\" data-kid=\"1-1-2-1-1\" data-name=\"dot 1\">\n                </span>\n                <span class=\"h-3 w-3 rounded-full bg-[var(--espresso)]\" data-kid=\"1-1-2-1-2\" data-name=\"dot 2\">\n                </span>\n                <span class=\"h-3 w-3 rounded-full bg-[var(--espresso)]\" data-kid=\"1-1-2-1-3\" data-name=\"dot 3\">\n                </span>\n                <span class=\"h-3 w-3 rounded-full bg-[var(--espresso)]\" data-kid=\"1-1-2-1-4\" data-name=\"dot 4\">\n                </span>\n                <span class=\"h-3 w-3 rounded-full bg-[var(--espresso)]\" data-kid=\"1-1-2-1-5\" data-name=\"dot 5\">\n                </span>\n                <span class=\"h-3 w-3 rounded-full bg-[var(--espresso)]\" data-kid=\"1-1-2-1-6\" data-name=\"dot 6\">\n                </span>\n                <span class=\"h-3 w-3 rounded-full border border-[var(--oxblood)] bg-[var(--paper)]\" data-kid=\"1-1-2-1-7\" data-name=\"current day dot\">\n                </span>\n            </div>\n            <p class=\"text-[12px] font-semibold\" data-kid=\"1-1-2-2\" data-name=\"streak count label\">\n                6 days in a row\n            </p>\n        </div>\n    </header>\n    <section aria-labelledby=\"today-slip-title\" class=\"px-3\" data-kid=\"1-2\" data-name=\"today's reflection section\">\n        <div class=\"mb-3 flex items-end justify-between\" data-kid=\"1-2-1\" data-name=\"section header container\">\n            <div data-kid=\"1-2-1-1\" data-name=\"title container\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--lichen)]\" data-kid=\"1-2-1-1-1\" data-name=\"ritual type label\">\n                    Tuesday ritual\n                </p>\n                <h1 class=\"mt-1 font-alegreya text-[22px] leading-none\" data-kid=\"1-2-1-1-2\" data-name=\"today's reflection title\" id=\"today-slip-title\">\n                    A small pause for today.\n                </h1>\n            </div>\n            <p class=\"text-[10px] uppercase tracking-[0.16em] text-[var(--lichen)]\" data-kid=\"1-2-1-2\" data-name=\"date indicator text\">\n                01 / 30\n            </p>\n        </div>\n        <div class=\"relative mr-6 pb-2\" data-kid=\"1-2-2\" data-name=\"reflection slip container\">\n            <div aria-hidden=\"true\" class=\"folio-back-one\" data-kid=\"1-2-2-1\" data-name=\"paper background layer 1\">\n            </div>\n            <div aria-hidden=\"true\" class=\"folio-back-two\" data-kid=\"1-2-2-2\" data-name=\"paper background layer 2\">\n            </div>\n            <article aria-label=\"Daily reflection slip\" class=\"folio-slip z-10 min-h-[510px]\" data-kid=\"1-2-2-3\" data-name=\"reflection slip\">\n                <div class=\"flex items-start justify-between border-b border-[var(--espresso)] px-4 pb-3 pt-4 pr-5\" data-kid=\"1-2-2-3-1\" data-name=\"slip header\">\n                    <div class=\"border-l-[3px] border-[var(--oxblood)] pl-2.5\" data-kid=\"1-2-2-3-1-1\" data-name=\"date block\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.17em] text-[var(--lichen)]\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"day of week label\">\n                            Tuesday\n                        </p>\n                        <p class=\"mt-1 font-alegreya text-[24px] leading-none\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"full date text\">\n                            September 1\n                        </p>\n                    </div>\n                    <p class=\"pt-1 text-[10px] font-semibold uppercase tracking-[0.17em] text-[var(--oxblood)]\" data-kid=\"1-2-2-3-1-2\" data-name=\"current status label\">\n                        Today\n                    </p>\n                </div>\n                <div class=\"px-4 pb-0 pr-[5.5rem] pt-7\" data-kid=\"1-2-2-3-2\" data-name=\"reflection body\">\n                    <p class=\"max-w-[220px] font-alegreya text-[27px] leading-[1.04]\" data-kid=\"1-2-2-3-2-1\" data-name=\"reflection prompt\">\n                        What would you like to leave with today?\n                    </p>\n                    <div class=\"mt-7\" data-kid=\"1-2-2-3-2-2\" data-name=\"reflection input field group\">\n                        <div class=\"mb-2 flex items-end justify-between gap-2\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"reflection input header\">\n                            <label class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--lichen)]\" data-kid=\"1-2-2-3-2-2-1-1\" data-name=\"reflection label\" for=\"reflection\">\n                                Your reflection\n                            </label>\n                            <p aria-live=\"polite\" class=\"text-right text-[10px] font-semibold uppercase tracking-[0.12em] text-[var(--oxblood)]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-1-2\" data-name=\"mood confirmation text\" data-reason=\"text updated via script on mood button click\" id=\"mood-confirmation\">\n                                Mood set to Light.\n                            </p>\n                        </div>\n                        <div class=\"ruled-field relative\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"textarea wrapper\">\n                            <textarea aria-label=\"Your reflection\" class=\"folio-textarea font-alegreya block h-[132px] w-full resize-none border-0 bg-transparent p-0 text-[19px] leading-[32px] text-[var(--espresso)]\" data-kid=\"1-2-2-3-2-2-2-1\" data-name=\"reflection input area\" id=\"reflection\" placeholder=\"Start with one sentence…\"></textarea>\n                            <span class=\"focus-rule absolute bottom-0 left-0 h-px w-full bg-transparent\" data-kid=\"1-2-2-3-2-2-2-2\" data-name=\"focus indicator rule\">\n                            </span>\n                        </div>\n                        <p class=\"mt-3 text-[11px] text-[var(--lichen)]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2-3\" data-name=\"autosave notification text\" data-reason=\"text updated via script on input event\" id=\"autosave-note\">\n                            • saved automatically as you write\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-6 border-t border-[var(--edge)]\" data-kid=\"1-2-2-3-3\" data-name=\"slip footer\">\n                    <button aria-live=\"polite\" class=\"block h-[50px] w-full bg-[var(--espresso)] px-4 text-[12px] font-semibold tracking-[0.04em] text-[var(--paper)]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-3-1\" data-name=\"save reflection button\" data-reason=\"text updated via script on click event\" id=\"save-reflection\" type=\"button\">\n                        Save reflection\n                    </button>\n                    <button class=\"ml-auto block px-4 py-3 text-[12px] font-semibold text-[var(--oxblood)] underline decoration-[var(--oxblood)] underline-offset-4\" data-kid=\"1-2-2-3-3-2\" data-name=\"edit button\" type=\"button\">\n                        Edit\n                    </button>\n                </div>\n                <div aria-label=\"Choose a mood\" class=\"mood-rail absolute top-[88px] z-20 flex flex-col gap-1.5\" data-kid=\"1-2-2-3-4\" data-name=\"mood selection rail\">\n                    <button aria-pressed=\"false\" class=\"mood-tongue flex shrink-0 items-center gap-2 bg-[var(--lichen)] px-4 text-left text-[11px] font-semibold leading-none text-[var(--paper)]\" data-kid=\"1-2-2-3-4-1\" data-mood=\"Drained\" data-name=\"drained mood button\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"mood-notch is-dotted\" data-kid=\"1-2-2-3-4-1-1\" data-name=\"drained mood notch icon\">\n                        </span>\n                        <span data-kid=\"1-2-2-3-4-1-2\" data-name=\"drained mood text\">\n                            Drained\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"mood-tongue flex shrink-0 items-center gap-2 bg-[var(--ochre)] px-4 text-left text-[11px] font-semibold leading-none text-[var(--espresso)]\" data-kid=\"1-2-2-3-4-2\" data-mood=\"Low\" data-name=\"low mood button\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"mood-notch is-dashed\" data-kid=\"1-2-2-3-4-2-1\" data-name=\"low mood notch icon\">\n                        </span>\n                        <span data-kid=\"1-2-2-3-4-2-2\" data-name=\"low mood text\">\n                            Low\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"mood-tongue flex shrink-0 items-center gap-2 bg-[var(--edge)] px-4 text-left text-[11px] font-semibold leading-none text-[var(--espresso)]\" data-kid=\"1-2-2-3-4-3\" data-mood=\"Steady\" data-name=\"steady mood button\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"mood-notch is-double\" data-kid=\"1-2-2-3-4-3-1\" data-name=\"steady mood notch icon\">\n                        </span>\n                        <span data-kid=\"1-2-2-3-4-3-2\" data-name=\"steady mood text\">\n                            Steady\n                        </span>\n                    </button>\n                    <button aria-pressed=\"true\" class=\"mood-tongue is-selected flex shrink-0 items-center gap-2 bg-[var(--oxblood)] px-4 text-left text-[11px] font-semibold leading-none text-[var(--paper)]\" data-kid=\"1-2-2-3-4-4\" data-mood=\"Light\" data-name=\"light mood button\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"mood-notch is-slanted\" data-kid=\"1-2-2-3-4-4-1\" data-name=\"light mood notch icon\">\n                        </span>\n                        <span data-kid=\"1-2-2-3-4-4-2\" data-name=\"light mood text\">\n                            Light\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"mood-tongue flex shrink-0 items-center gap-2 bg-[var(--espresso)] px-4 text-left text-[11px] font-semibold leading-none text-[var(--paper)]\" data-kid=\"1-2-2-3-4-5\" data-mood=\"Energized\" data-name=\"energized mood button\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"mood-notch\" data-kid=\"1-2-2-3-4-5-1\" data-name=\"energized mood notch icon\">\n                        </span>\n                        <span data-kid=\"1-2-2-3-4-5-2\" data-name=\"energized mood text\">\n                            Energized\n                        </span>\n                    </button>\n                </div>\n            </article>\n        </div>\n    </section>\n    <section aria-labelledby=\"history-title\" class=\"mt-10 px-3\" data-kid=\"1-3\" data-name=\"history section\">\n        <div class=\"border-t border-[var(--espresso)] pt-4\" data-kid=\"1-3-1\" data-name=\"history content wrapper\">\n            <div class=\"flex items-end justify-between\" data-kid=\"1-3-1-1\" data-name=\"history header container\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"history header group\">\n                    <h2 class=\"text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--lichen)]\" data-kid=\"1-3-1-1-1-1\" data-name=\"history title\" id=\"history-title\">\n                        History\n                    </h2>\n                    <div class=\"date-tab mt-2 w-[132px] px-3 pb-2 pt-2\" data-kid=\"1-3-1-1-1-2\" data-name=\"date tab container\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.15em]\" data-kid=\"1-3-1-1-1-2-1\" data-name=\"month label\">\n                            September\n                        </p>\n                        <p class=\"font-alegreya text-[23px] leading-none\" data-kid=\"1-3-1-1-1-2-2\" data-name=\"year label\">\n                            2026\n                        </p>\n                    </div>\n                </div>\n                <p class=\"pb-1 text-right text-[11px] leading-[1.35] text-[var(--lichen)]\" data-kid=\"1-3-1-1-2\" data-name=\"total reflections label\">\n                    <span class=\"font-semibold text-[var(--espresso)]\" data-kid=\"1-3-1-1-2-1\" data-name=\"reflection count bold text\">\n                        10 reflections\n                    </span>\n                    <br data-kid=\"1-3-1-1-2-2\" data-name=\"line break\"/>\n                    this month\n                </p>\n            </div>\n            <div aria-hidden=\"true\" class=\"mt-5 grid grid-cols-7 gap-1 px-1 text-center text-[9px] font-semibold uppercase tracking-[0.12em] text-[var(--lichen)]\" data-kid=\"1-3-1-2\" data-name=\"calendar weekday header\">\n                <span data-kid=\"1-3-1-2-1\" data-name=\"monday label\">\n                    M\n                </span>\n                <span data-kid=\"1-3-1-2-2\" data-name=\"tuesday label\">\n                    T\n                </span>\n                <span data-kid=\"1-3-1-2-3\" data-name=\"wednesday label\">\n                    W\n                </span>\n                <span data-kid=\"1-3-1-2-4\" data-name=\"thursday label\">\n                    T\n                </span>\n                <span data-kid=\"1-3-1-2-5\" data-name=\"friday label\">\n                    F\n                </span>\n                <span data-kid=\"1-3-1-2-6\" data-name=\"saturday label\">\n                    S\n                </span>\n                <span data-kid=\"1-3-1-2-7\" data-name=\"sunday label\">\n                    S\n                </span>\n            </div>\n            <div class=\"mt-1 grid grid-cols-7 gap-1\" data-kid=\"1-3-1-3\" data-name=\"calendar days grid\">\n                <span aria-hidden=\"true\" class=\"h-11\" data-kid=\"1-3-1-3-1\" data-name=\"empty spacer 1\">\n                </span>\n                <button aria-label=\"Tuesday, September 1, selected\" class=\"history-day is-selected flex h-11 min-w-0 items-center justify-center bg-[var(--oxblood)] text-[12px] text-[var(--paper)]\" data-kid=\"1-3-1-3-2\" data-name=\"day 1 button\" type=\"button\">\n                    <span data-kid=\"1-3-1-3-2-1\" data-name=\"day 1 number\">\n                        1\n                    </span>\n                    <span aria-hidden=\"true\" class=\"mood-notch-small bg-[var(--paper)]\" data-kid=\"1-3-1-3-2-2\" data-name=\"day 1 status icon\">\n                    </span>\n                    <span aria-hidden=\"true\" class=\"writing-line\" data-kid=\"1-3-1-3-2-3\" data-name=\"day 1 line\">\n                    </span>\n                </button>\n                <button aria-label=\"Wednesday, September 2\" class=\"history-day flex h-11 min-w-0 items-center justify-center text-[12px]\" data-kid=\"1-3-1-3-3\" data-name=\"day 2 button\" type=\"button\">\n                    <span data-kid=\"1-3-1-3-3-1\" data-name=\"day 2 number\">\n                        2\n                    </span>\n                    <span aria-hidden=\"true\" class=\"mood-notch-small bg-[var(--lichen)]\" data-kid=\"1-3-1-3-3-2\" data-name=\"day 2 status icon\">\n                    </span>\n                    <span aria-hidden=\"true\" class=\"writing-line\" data-kid=\"1-3-1-3-3-3\" data-name=\"day 2 line\">\n                    </span>\n                </button>\n                <button aria-label=\"Thursday, September 3\" class=\"history-day flex h-11 min-w-0 items-center justify-center text-[12px]\" data-kid=\"1-3-1-3-4\" data-name=\"day 3 button\" type=\"button\">\n                    <span data-kid=\"1-3-1-3-4-1\" data-name=\"day 3 number\">\n                        3\n                    </span>\n                    <span aria-hidden=\"true\" class=\"mood-notch-small bg-[var(--oxblood)]\" data-kid=\"1-3-1-3-4-2\" data-name=\"day 3 status icon\">\n                    </span>\n                    <span aria-hidden=\"true\" class=\"writing-line\" data-kid=\"1-3-1-3-4-3\" data-name=\"day 3 line\">\n                    </span>\n                </button>\n                <button aria-label=\"Friday, September 4\" class=\"history-day flex h-11 min-w-0 items-center justify-center text-[12px]\" data-kid=\"1-3-1-3-5\" data-name=\"day 4 button\" type=\"button\">\n                    <span data-kid=\"1-3-1-3-5-1\" data-name=\"day 4 number\">\n                        4\n                    </span>\n                    <span aria-hidden=\"true\" class=\"mood-notch-small bg-[var(--ochre)]\" data-kid=\"1-3-1-3-5-2\" data-name=\"day 4 status icon\">\n                    </span>\n                    <span aria-hidden=\"true\" class=\"writing-line\" data-kid=\"1-3-1-3-5-3\" data-name=\"day 4 line\">\n                    </span>\n                </button>\n                <button aria-label=\"Saturday, September 5\" class=\"history-day flex h-11 min-w-0 items-center justify-center text-[12px]\" data-kid=\"1-3-1-3-6\" data-name=\"day 5 button\" type=\"button\">\n                    <span data-kid=\"1-3-1-3-6-1\" data-name=\"day 5 number\">\n                        5\n                    </span>\n                </button>\n                <button aria-label=\"Sunday, September 6\" class=\"history-day flex h-11 min-w-0 items-center justify-center text-[12px]\" data-kid=\"1-3-1-3-7\" data-name=\"day 6 button\" type=\"button\">\n                    <span data-kid=\"1-3-1-3-7-1\" data-name=\"day 6 number\">\n                        6\n                    </span>\n                </button>\n                <button aria-label=\"Monday, September 7\" class=\"history-day flex h-11 min-w-0 items-center justify-center text-[12px]\" data-kid=\"1-3-1-3-8\" data-name=\"day 7 button\" type=\"button\">\n                    <span data-kid=\"1-3-1-3-8-1\" data-name=\"day 7 number\">\n                        7\n                    </span>\n                </button>\n                <button aria-label=\"Tuesday, September 8\" class=\"history-day flex h-11 min-w-0 items-center justify-center text-[12px]\" data-kid=\"1-3-1-3-9\" data-name=\"day 8 button\" type=\"button\">\n                    <span data-kid=\"1-3-1-3-9-1\" data-name=\"day 8 number\">\n                        8\n                    </span>\n                    <span aria-hidden=\"true\" class=\"mood-notch-small bg-[var(--oxblood)]\" data-kid=\"1-3-1-3-9-2\" data-name=\"day 8 status icon\">\n                    </span>\n                    <span aria-hidden=\"true\" class=\"writing-line\" data-kid=\"1-3-1-3-9-3\" data-name=\"day 8 line\">\n                    </span>\n                </button>\n                <button aria-label=\"Wednesday, September 9\" class=\"history-day flex h-11 min-w-0 items-center justify-center text-[12px]\" data-kid=\"1-3-1-3-10\" data-name=\"day 9 button\" type=\"button\">\n                    <span data-kid=\"1-3-1-3-10-1\" data-name=\"day 9 number\">\n                        9\n                    </span>\n                </button>\n                <butto