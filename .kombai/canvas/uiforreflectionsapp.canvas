election script\" hidden=\"\">\n                        </span>\n                    </button>\n                </div>\n                <p aria-live=\"polite\" class=\"mt-3 mt-mono text-[10px] uppercase tracking-[.1em] text-[var(--mt-coral)]\" data-dynamic=\"true\" data-kid=\"1-1-1-3-4\" data-name=\"mood confirmation message\" data-reason=\"text updated by selection script\" id=\"mood-confirmation\">\n                    Recorded as Steady.\n                </p>\n            </section>\n            <section class=\"relative mt-8 pl-4\" data-kid=\"1-1-1-4\" data-name=\"write reflection section\">\n                <span class=\"mt-cross-tick pointer-events-none absolute top-5 h-px bg-[var(--mt-teal)]\" data-kid=\"1-1-1-4-1\" data-name=\"section accent tick\">\n                </span>\n                <div class=\"-ml-4 bg-[var(--mt-paper)] px-4 py-5\" data-kid=\"1-1-1-4-2\" data-name=\"reflection form container\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-1-4-2-1\" data-name=\"reflection header container\">\n                        <span class=\"mt-mono text-[10px] uppercase tracking-[.12em] text-[var(--mt-muted)]\" data-kid=\"1-1-1-4-2-1-1\" data-name=\"reflection date label\">\n                            SEP 01 / PROMPT\n                        </span>\n                        <span class=\"mt-mono text-[9px] uppercase tracking-[.1em] text-[var(--mt-teal)]\" data-kid=\"1-1-1-4-2-1-2\" data-name=\"reflection section number\">\n                            02 / write\n                        </span>\n                    </div>\n                    <h2 class=\"mt-4 max-w-[285px] text-[20px] leading-[1.24] tracking-[-.025em]\" data-kid=\"1-1-1-4-2-2\" data-name=\"reflection heading\">\n                        What stayed with you after the day ended?\n                    </h2>\n                    <label class=\"mt-8 block mt-mono text-[10px] uppercase tracking-[.12em] text-[var(--mt-muted)]\" data-kid=\"1-1-1-4-2-3\" dat