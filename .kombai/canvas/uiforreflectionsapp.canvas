    "inspiration_node_faa31084316a": {
      "type": "variant",
      "id": "inspiration_node_faa31084316a",
      "label": "Havenest",
      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19758/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/uiforreflectionsapp.canvas\", nodeId: \"inspiration_node_faa31084316a\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><style>\n  :root{\n    --brand:#0E9F6E;\n    --brand-dark:#0A7F58;\n    --brand-light:#E3F7EF;\n    --badge:#0E9F6E;\n    --badge-light:#E3F7EF;\n    --ink:#222222;\n    --ink-soft:#484848;\n    --gray-500:#717171;\n    --gray-300:#DDDDDD;\n    --gray-200:#EBEBEB;\n    --gray-100:#F7F7F7;\n    --surface:#FFFFFF;\n    --range-bg:#F2F2F2;\n    --radius-lg:20px;\n    --radius-md:14px;\n    --radius-sm:8px;\n    --shadow-modal:0 24px 64px rgba(0,0,0,.20), 0 2px 10px rgba(0,0,0,.08);\n    --shadow-card:0 1px 2px rgba(0,0,0,.08);\n    --font: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    font-family:var(--font);\n    color:var(--ink);\n    background:var(--surface);\n    -webkit-font-smoothing:antialiased;\n    overflow-x:hidden;\n  }\n  a{text-decoration:none;color:inherit;}\n  button{font-family:inherit;cursor:pointer;}\n  img,svg{max-width:100%;display:block;}\n  button, .nav-item, .chip, .tab, .search-field{\n    transition:background-color .16s cubic-bezier(.16,1,.3,1), border-color .16s cubic-bezier(.16,1,.3,1), color .16s cubic-bezier(.16,1,.3,1), transform .16s cubic-bezier(.16,1,.3,1);\n  }\n  button:active{transform:translateY(1px);}\n  button:focus-visible, a:focus-visible{outline:2px solid var(--brand); outline-offset:2px;}\n  .nav-item:hover{color:var(--ink);}\n  .row-nav button:hover, .month-nav:hover, .menu-btn:hover{border-color:var(--ink); background:var(--gray-100);}\n  .chip:hover{border-color:var(--ink);}\n  .tab:hover{color:var(--ink);}\n  .search-cta:hover{background:var(--brand-dark);}\n\n  /* ---------- Header ---------- */\n  .site-header{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:22px clamp(20px,5vw,80px);\n    border-bottom:1px solid var(--gray-200);\n    gap:12px;\n  }\n  .logo,.header-right{flex:0 0 auto;min-width:0;}\n  .main-nav{min-width:0;}\n  .logo{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    font-size:22px;\n    font-weight:800;\n    color:var(--brand-dark);\n    letter-spacing:-0.02em;\n  }\n  .logo svg{width:30px;height:30px;flex:0 0 auto;}\n  .main-nav{\n    display:flex;\n    align-items:center;\n    gap:44px;\n  }\n  .nav-item{\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    gap:8px;\n    font-size:15px;\n    font-weight:600;\n    color:var(--gray-500);\n    padding-bottom:14px;\n    position:relative;\n    white-space:nowrap;\n  }\n  .nav-item .icon-row{display:flex;align-items:center;gap:6px;}\n  .nav-item svg{width:22px;height:22px;}\n  .nav-item.active{color:var(--ink);}\n  .nav-item.active::after{\n    content:\"\";\n    position:absolute;\n    bottom:0;left:0;right:0;\n    height:2px;\n    background:var(--ink);\n    border-radius:2px;\n  }\n  .badge-new{\n    background:var(--badge);\n    color:#fff;\n    font-size:10px;\n    font-weight:800;\n    letter-spacing:.04em;\n    padding:2px 6px;\n    border-radius:5px;\n  }\n  .header-right{\n    display:flex;\n    align-items:center;\n    gap:20px;\n  }\n  .become-host{\n    font-size:14px;\n    font-weight:600;\n    display:none;\n  }\n  @media(min-width:900px){ .become-host{display:block;} }\n  .avatar{\n    width:34px;height:34px;border-radius:50%;\n    background:linear-gradient(135deg,var(--brand),#0a5c40);\n    display:flex;align-items:center;justify-content:center;\n    color:#fff;font-size:13px;font-weight:700;\n  }\n  .menu-btn{\n    display:flex;align-items:center;justify-content:center;\n    width:42px;height:42px;border-radius:50%;\n    border:1px solid var(--gray-300);\n    background:#fff;\n    position:relative;\n  }\n  .menu-btn svg{width:16px;height:16px;}\n  .menu-dot{\n    position:absolute;top:8px;right:9px;\n    width:8px;height:8px;border-radius:50%;\n    background:var(--badge);\n    border:2px solid #fff;\n  }\n\n  /* ---------- Search band ---------- */\n  .search-band{\n    background:var(--gray-100);\n    padding:22px clamp(20px,5vw,80px) 26px;\n    position:relative;\n    z-index:5;\n  }\n  .search-pill{\n    max-width:920px;\n    margin:0 auto;\n    background:#fff;\n    border-radius:999px;\n    box-shadow:var(--shadow-card), 0 0 0 1px var(--gray-200);\n    display:flex;\n    align-items:stretch;\n    overflow:hidden;\n  }\n  .search-field{\n    flex:1;\n    padding:12px 26px;\n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    gap:2px;\n    border-right:1px solid var(--gray-200);\n    min-width:0;\n  }\n  .search-field:last-of-type{border-right:none;}\n  .search-field.active{\n    background:#fff;\n    border-radius:999px;\n    box-shadow:var(--shadow-card), 0 0 0 1px var(--gray-200);\n    position:relative;\n    z-index:2;\n  }\n  .search-field .f-label{\n    font-size:12px;font-weight:700;color:var(--ink);\n  }\n  .search-field .f-value{\n    font-size:14px;color:var(--gray-500);\n    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n    display:flex;align-items:center;gap:6px;\n  }\n  .clear-x{\n    margin-left:auto;\n    width:22px;height:22px;border-radius:50%;\n    background:var(--ink);color:#fff;\n    display:flex;align-items:center;justify-content:center;\n    flex:0 0 auto;\n  }\n  .clear-x svg{width:11px;height:11px;}\n  .search-cta{\n    margin:8px 8px 8px 0;\n    background:var(--brand);\n    color:#fff;\n    border:none;\n    border-radius:999px;\n    padding:0 20px;\n    display:flex;align-items:center;gap:8px;\n    font-size:14px;font-weight:700;\n    flex:0 0 auto;\n  }\n  .search-cta svg{width:16px;height:16px;}\n  @media(max-width:760px){\n    .search-field .f-label{font-size:11px;}\n    .search-field{padding:12px 14px;}\n    .search-cta span{display:none;}\n    .search-cta{border-radius:50%;width:40px;height:40px;padding:0;justify-content:center;}\n  }\n\n  /* ---------- Content ---------- */\n  .content{\n    max-width:1400px;\n    margin:0 auto;\n    padding:34px clamp(20px,5vw,80px) 0;\n    position:relative;\n  }\n  .row{margin-bottom:38px;}\n  .row-head{\n    display:flex;align-items:center;justify-content:space-between;\n    margin-bottom:16px;\n  }\n  .row-head h2{\n    font-size:22px;margin:0;font-weight:700;letter-spacing:-.01em;\n  }\n  .row-nav{display:flex;gap:8px;}\n  .row-nav button{\n    width:34px;height:34px;border-radius:50%;\n    border:1px solid var(--gray-300);background:#fff;\n    display:flex;align-items:center;justify-content:center;\n  }\n  .row-nav svg{width:14px;height:14px;}\n  .card-track{\n    display:flex;gap:22px;overflow-x:auto;\n    scrollbar-width:none;padding-bottom:4px;\n  }\n  .card-track::-webkit-scrollbar{display:none;}\n  .card{\n    flex:0 0 auto;\n    width:230px;\n  }\n  .thumb{\n    position:relative;\n    width:100%;\n    aspect-ratio:1/1;\n    border-radius:var(--radius-md);\n    overflow:hidden;\n    margin-bottom:10px;\n    background:var(--gray-200);\n  }\n  .thumb.g1{background:linear-gradient(135deg,#FBEFD9,#F0B27A 60%,#C97B3E);}\n  .thumb.g2{background:linear-gradient(135deg,#DCEFE9,#8FC7B4 55%,#3E7D67);}\n  .thumb.g3{background:linear-gradient(135deg,#E8E2F7,#B6A4E0 55%,#6E56B0);}\n  .thumb.g4{background:linear-gradient(135deg,#FDE2E2,#F0A0A0 55%,#C24E4E);}\n  .thumb.g5{background:linear-gradient(135deg,#E1EEF9,#93BEE0 55%,#3E6E9E);}\n  .thumb.g6{background:linear-gradient(135deg,#F5EBD8,#D9BE86 55%,#946E33);}\n  .thumb.g7{background:linear-gradient(135deg,#E5F2E0,#9FCB8B 55%,#4C7C3A);}\n  .thumb-shape{\n    position:absolute;inset:0;\n    opacity:.18;\n    background-image:\n      radial-gradient(circle at 20% 80%, rgba(255,255,255,.35), transparent 45%),\n      radial-gradient(circle at 80% 25%, rgba(0,0,0,.18), transparent 50%);\n  }\n  .badge-pill{\n    position:absolute;top:10px;left:10px;\n    background:#fff;color:var(--ink);\n    font-size:11px;font-weight:700;\n    padding:6px 10px;border-radius:999px;\n    box-shadow:var(--shadow-card);\n  }\n  .heart{\n    position:absolute;top:10px;right:10px;\n    width:24px;height:24px;\n  }\n  .heart svg{width:100%;height:100%;filter:drop-shadow(0 1px 2px rgba(0,0,0,.35));}\n  .card-title{font-size:14px;font-weight:600;margin:0 0 3px;}\n  .card-meta{font-size:13px;color:var(--gray-500);display:flex;align-items:center;gap:4px;}\n  .card-meta svg{width:12px;height:12px;fill:var(--ink);}\n  .badge-card{\n    display:flex;flex-direction:column;align-items:center;justify-content:center;\n    text-align:center;\n    background:var(--brand-light);\n    border:2px dashed var(--brand);\n    border-radius:50%;\n    aspect-ratio:1/1;\n    width:100%;\n    padding:14px;\n  }\n  .badge-card svg{width:34px;height:34px;margin-bottom:6px;}\n  .badge-card b{font-size:13px;line-height:1.25;color:var(--brand-dark);}\n  .badge-card span{font-size:10px;letter-spacing:.06em;color:var(--brand-dark);text-transform:uppercase;margin-top:2px;}\n\n  /* ---------- Calendar modal ---------- */\n  .modal-wrap{\n    display:flex;\n    justify-content:center;\n    position:absolute;\n    top:-6px;\n    left:0;right:0;\n    z-index:20;\n    padding:0 20px;\n  }\n  .modal{\n    width:100%;\n    max-width:1020px;\n    background:#fff;\n    border-radius:24px;\n    box-shadow:var(--shadow-modal);\n    padding:32px clamp(18px,4vw,56px) 28px;\n  }\n  .tabs{\n    display:flex;justify-content:center;margin-bottom:26px;\n  }\n  .tabs-inner{\n    display:flex;background:var(--gray-100);border-radius:999px;padding:4px;gap:4px;\n  }\n  .tab{\n    border:none;background:transparent;\n    padding:10px 22px;border-radius:999px;\n    font-size:14px;font-weight:700;color:var(--gray-500);\n  }\n  .tab.active{background:#fff;color:var(--ink);box-shadow:var(--shadow-card);}\n\n  .months{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:clamp(20px,6vw,90px);\n  }\n  @media(max-width:700px){\n    .months{grid-template-columns:1fr;}\n    .month:last-child{display:none;}\n  }\n  .month-head{\n    display:flex;align-items:center;justify-content:center;gap:14px;\n    margin-bottom:18px;position:relative;\n  }\n  .month-head h3{font-size:16px;font-weight:700;margin:0;}\n  .month-nav{\n    width:28px;height:28px;border-radius:50%;\n    border:1px solid var(--gray-300);background:#fff;\n    display:flex;align-items:center;justify-content:center;\n    position:absolute;\n  }\n  .month-nav svg{width:11px;height:11px;}\n  .month-nav.prev{left:0;}\n  .month-nav.next{right:0;}\n  .month:first-child .month-nav.next,\n  .month:last-child .month-nav.prev{visibility:hidden;}\n\n  .weekdays,.weeks{display:grid;grid-template-columns:repeat(7,1fr);}\n  .weekdays div{\n    text-align:center;font-size:12px;font-weight:700;color:var(--gray-500);\n    padding-bottom:10px;\n  }\n  .day-cell{\n    aspect-ratio:1/1;\n    display:flex;align-items:center;justify-content:center;\n    position:relative;\n  }\n  .day-cell .num{\n    font-size:14px;color:var(--ink);\n    width:38px;height:38px;\n    display:flex;align-items:center;justify-content:center;\n    border-radius:50%;\n    position:relative;z-index:2;\n  }\n  .day-cell.muted .num{color:#DDDDDD;}\n  .day-cell.range-mid{background:var(--range-bg);}\n  .day-cell.range-start{background:linear-gradient(to right, transparent 50%, var(--range-bg) 50%); border-radius:0 999px 999px 0;}\n  .day-cell.range-end{background:linear-gradient(to right, var(--range-bg) 50%, transparent 50%); border-radius:999px 0 0 999px;}\n  .day-cell.range-end.row-end, .day-cell.range-mid.row-end{border-radius:0 999px 999px 0;}\n  .day-cell.range-start.row-start, .day-cell.range-mid.row-start{border-radius:999px 0 0 999px;}\n  .day-cell.selected .num{background:var(--ink);color:#fff;}\n  .day-cell.today .num{font-weight:800;box-shadow:inset 0 0 0 1.5px var(--ink);}\n\n  .quick-ranges{\n    display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-start;\n    margin-top:26px;\n  }\n  .chip{\n    border:1px solid var(--gray-300);\n    background:#fff;\n    padding:10px 16px;\n    border-radius:999px;\n    font-size:13px;font-weight:600;color:var(--ink);\n  }\n  .chip.active{border:2px solid var(--ink);padding:9px 15px;}\n\n  /* ---------- Footer ---------- */\n  .site-footer{\n    margin-top:52px;\n    background:#1B1B1B;\n    color:#fff;\n    display:flex;align-items:center;justify-content:space-between;\n    padding:18px clamp(20px,5vw,80px);\n    flex-wrap:wrap;\n    gap:10px;\n  }\n  .footer-brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:15px;}\n  .footer-brand svg{width:22px;height:22px;}\n  .footer-tag{font-size:13px;color:#B9B9B9;display:flex;align-items:center;gap:8px;}\n  .footer-tag b{color:#fff;font-weight:700;}\n\n  @media(max-width:900px){\n    .main-nav{gap:24px;}\n    .nav-item span.label{display:none;}\n  }\n  @media(max-width:640px){\n    .main-nav{display:none;}\n    .site-header{padding:14px 16px;}\n    .logo{font-size:18px;gap:7px;}\n    .logo svg{width:24px;height:24px;}\n    .header-right{gap:12px;}\n    .avatar{width:30px;height:30px;font-size:11px;}\n    .menu-btn{width:36px;height:36px;}\n    .search-band{padding:16px 16px 20px;}\n    .search-pill{overflow-x:auto;border-radius:20px;-webkit-overflow-scrolling:touch;}\n    .search-field{flex:0 0 auto;min-width:130px;}\n    .search-field.active{min-width:150px;}\n    .content{padding:26px 16px 0;}\n    .modal-wrap{top:-6px;padding:0 10px;}\n    .modal{padding:22px 16px 20px;border-radius:18px;}\n  }\n</style>\n\n\n  <header class=\"site-header\">\n    <div class=\"logo\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3 2 11h2.5v9H10v-6h4v6h5.5v-9H22L12 3Z\" fill=\"currentColor\"></path></svg>\n      Havenest\n    </div>\n    <nav class=\"main-nav\">\n      <a class=\"nav-item active\" href=\"#\">\n        <span class=\"icon-row\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M3 11.5 12 4l9 7.5\"></path><path d=\"M5 10v9h14v-9\"></path><path d=\"M10 19v-6h4v6\"></path></svg>\n        </span>\n        <span class=\"label\">Stays</span>\n      </a>\n      <a class=\"nav-item\" href=\"#\">\n        <span class=\"icon-row\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"10\" r=\"6\"></circle><path d=\"M9 10a3 3 0 0 1 6 0\"></path><path d=\"M12 16v5\"></path><path d=\"M9 21h6\"></path></svg>\n          <span class=\"badge-new\">NEW</span>\n        </span>\n        <span class=\"label\">Experiences</span>\n      </a>\n      <a class=\"nav-item\" href=\"#\">\n        <span class=\"icon-row\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M4 18h16\"></path><path d=\"M5 18a7 7 0 0 1 14 0\"></path><path d=\"M12 6v3\"></path><circle cx=\"12\" cy=\"4\" r=\"1.4\" fill=\"currentColor\" stroke=\"none\"></circle></svg>\n          <span class=\"badge-new\">NEW</span>\n        </span>\n        <span class=\"label\">Concierge</span>\n      </a>\n    </nav>\n    <div class=\"header-right\">\n      <a class=\"become-host\" href=\"#\">List your place</a>\n      <div class=\"avatar\">JM</div>\n      <button class=\"menu-btn\" aria-label=\"Menu\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 6h18M3 12h18M3 18h18\"></path></svg>\n        <span class=\"menu-dot\"></span>\n      </button>\n    </div>\n  </header>\n\n  <div class=\"search-band\">\n    <div class=\"search-pill\">\n      <div class=\"search-field\">\n        <div class=\"f-label\">Where to</div>\n        <div class=\"f-value\">Sedona</div>\n      </div>\n      <div class=\"search-field\">\n        <div class=\"f-label\">Check in</div>\n        <div class=\"f-value\">Jul 24 ±3</div>\n      </div>\n      <div class=\"search-field active\">\n        <div class=\"f-label\">Check out</div>\n        <div class=\"f-value\">Jul 30 ±3 <span class=\"clear-x\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.5\"><path d=\"M6 6l12 12M18 6 6 18\"></path></svg></span></div>\n      </div>\n      <div class=\"search-field\">\n        <div class=\"f-label\">Who</div>\n        <div class=\"f-value\" style=\"color:var(--gray-500);\">Add guests</div>\n      </div>\n      <button class=\"search-cta\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><circle cx=\"11\" cy=\"11\" r=\"7\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg>\n        <span>Search</span>\n      </button>\n    </div>\n  </div>\n\n  <div class=\"content\">\n\n    <section class=\"row\">\n      <div class=\"row-head\">\n        <h2>Popular stays in Kyoto</h2>\n        <div class=\"row-nav\">\n          <button aria-label=\"Previous\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"m15 6-6 6 6 6\"></path></svg></button>\n          <button aria-label=\"Next\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"m9 6 6 6-6 6\"></path></svg></button>\n        </div>\n      </div>\n      <div class=\"card-track\">\n        <div class=\"card\">\n          <div class=\"thumb g1\" role=\"img\" aria-label=\"Loft living room — Mateusz Pielech on Pexels\" style=\"background-image:url('https://images.pexels.com/photos/29252605/pexels-photo-29252605.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=500');background-size:cover;background-position:center;\"><div class=\"thumb-shape\"></div>\n            <span class=\"badge-pill\">Guest favorite</span>\n            <span class=\"heart\"><svg viewBox=\"0 0 24 24\" fill=\"rgba(0,0,0,.35)\" stroke=\"#fff\" stroke-width=\"1.6\"><path d=\"M12 21s-7.5-4.6-10-9.3C.6 8 2.4 4.7 5.7 4.2c2-.3 3.7.7 6.3 3.1 2.6-2.4 4.3-3.4 6.3-3.1 3.3.5 5.1 3.8 3.7 7.5C19.5 16.4 12 21 12 21Z\"></path></svg></span>\n          </div>\n          <p class=\"card-title\">Loft near Gion Quarter</p>\n          <p class=\"card-meta\">$212 for 2 nights · ★4.91</p>\n        </div>\n        <div class=\"card\">\n          <div class=\"thumb g2\" role=\"img\" aria-label=\"Wooden apartment interior — William Warby on Pexels\" style=\"background-image:url('https://images.pexels.com/photos/19730417/pexels-photo-19730417.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=500');background-size:cover;background-position:center;\"><div class=\"thumb-shape\"></div>\n            <span class=\"heart\"><svg viewBox=\"0 0 24 24\" fill=\"rgba(0,0,0,.35)\" stroke=\"#fff\" stroke-width=\"1.6\"><path d=\"M12 21s-7.5-4.6-10-9.3C.6 8 2.4 4.7 5.7 4.2c2-.3 3.7.7 6.3 3.1 2.6-2.4 4.3-3.4 6.3-3.1 3.3.5 5.1 3.8 3.7 7.5C19.5 16.4 12 21 12 21Z\"></path></svg></span>\n          </div>\n          <p class=\"card-title\">Room with private garden</p>\n          <p class=\"card-meta\">$96 for 2 nights · ★4.86</p>\n        </div>\n        <div class=\"card\">\n          <div class=\"thumb g3\" role=\"img\" aria-label=\"Sunlit loft studio — ULISES RAMIREZ on Unsplash\" style=\"background-image:url('https://images.unsplash.com/photo-1783990350684-71c38af04a8a?q=80&amp;w=500');background-size:cover;background-position:center;\"><div class=\"thumb-shape\"></div>\n            <span class=\"badge-pill\">Guest favorite</span>\n            <span class=\"heart\"><svg viewBox=\"0 0 24 24\" fill=\"rgba(0,0,0,.35)\" stroke=\"#fff\" stroke-width=\"1.6\"><path d=\"M12 21s-7.5-4.6-10-9.3C.6 8 2.4 4.7 5.7 4.2c2-.3 3.7.7 6.3 3.1 2.6-2.4 4.3-3.4 6.3-3.1 3.3.5 5.1 3.8 3.7 7.5C19.5 16.4 12 21 12 21Z\"></path></svg></span>\n          </div>\n          <p class=\"card-title\">Studio above the river</p>\n          <p class=\"card-meta\">$168 for 2 nights · ★4.95</p>\n        </div>\n        <div class=\"card\">\n          <div class=\"badge-card\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--brand-dark)\" stroke-width=\"1.6\"><path d=\"M4 21V9l8-6 8 6v12\"></path><path d=\"M9 21v-7h6v7\"></path></svg>\n            <b>Fernwood Homes</b>\n            <span>Kyoto, JP</span>\n          </div>\n        </div>\n        <div class=\"card\">\n          <div class=\"thumb g6\" role=\"img\" aria-label=\"Traditional Kyoto machiya townhouse — Karolina on Pexels\" style=\"background-image:url('https://images.pexels.com/photos/38101094/pexels-photo-38101094.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=500');background-size:cover;background-position:center;\"><div class=\"thumb-shape\"></div>\n            <span class=\"heart\"><svg viewBox=\"0 0 24 24\" fill=\"rgba(0,0,0,.35)\" stroke=\"#fff\" stroke-width=\"1.6\"><path d=\"M12 21s-7.5-4.6-10-9.3C.6 8 2.4 4.7 5.7 4.2c2-.3 3.7.7 6.3 3.1 2.6-2.4 4.3-3.4 6.3-3.1 3.3.5 5.1 3.8 3.7 7.5C19.5 16.4 12 21 12 21Z\"></path></svg></span>\n          </div>\n          <p class=\"card-title\">Machiya townhouse</p>\n          <p class=\"card-meta\">$305 for 2 nights · ★4.98</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"row\">\n      <div class=\"row-head\">\n        <h2>Available next month in Lisbon</h2>\n        <div class=\"row-nav\">\n          <button aria-label=\"Previous\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"m15 6-6 6 6 6\"></path></svg></button>\n          <button aria-label=\"Next\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"m9 6 6 6-6 6\"></path></svg></button>\n        </div>\n      </div>\n      <div class=\"card-track\">\n        <div class=\"card\"><div class=\"thumb g4\" role=\"img\" aria-label=\"Modern living room — Max Vakhtbovych on Pexels\" style=\"background-image:url('https://images.pexels.com/photos/6077368/pexels-photo-6077368.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=500');background-size:cover;background-position:center;\"><div class=\"thumb-shape\"></div><span class=\"badge-pill\">Guest favorite</span><span class=\"heart\"><svg viewBox=\"0 0 24 24\" fill=\"rgba(0,0,0,.35)\" stroke=\"#fff\" stroke-width=\"1.6\"><path d=\"M12 21s-7.5-4.6-10-9.3C.6 8 2.4 4.7 5.7 4.2c2-.3 3.7.7 6.3 3.1 2.6-2.4 4.3-3.4 6.3-3.1 3.3.5 5.1 3.8 3.7 7.5C19.5 16.4 12 21 12 21Z\"></path></svg></span></div>\n          <p class=\"card-title\">Apartment in Alfama</p><p class=\"card-meta\">$318 for 2 nights · ★4.97</p></div>\n        <div class=\"card\"><div class=\"thumb g5\" role=\"img\" aria-label=\"Cozy bedroom interior — La Miko on Pexels\" style=\"background-image:url('https://images.pexels.com/photos/3754595/pexels-photo-3754595.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=500');background-size:cover;background-position:center;\"><div class=\"thumb-shape\"></div><span class=\"badge-pill\">Guest favorite</span><span class=\"heart\"><svg viewBox=\"0 0 24 24\" fill=\"rgba(0,0,0,.35)\" stroke=\"#fff\" stroke-width=\"1.6\"><path d=\"M12 21s-7.5-4.6-10-9.3C.6 8 2.4 4.7 5.7 4.2c2-.3 3.7.7 6.3 3.1 2.6-2.4 4.3-3.4 6.3-3.1 3.3.5 5.1 3.8 3.7 7.5C19.5 16.4 12 21 12 21Z\"></path></svg></span></div>\n          <p class=\"card-title\">Room in Belém</p><p class=\"card-meta\">$88 for 2 nights · ★4.99</p></div>\n        <div class=\"card\"><div class=\"thumb g7\" role=\"img\" aria-label=\"Light studio apartment — Max Vakhtbovych on Pexels\" style=\"background-image:url('https://images.pexels.com/photos/6782426/pexels-photo-6