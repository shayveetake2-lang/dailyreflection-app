    "inspiration_node_273b6f4a5ed4": {
      "type": "variant",
      "id": "inspiration_node_273b6f4a5ed4",
      "label": "Vesper",
      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19758/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/uiforreflectionsapp.canvas\", nodeId: \"inspiration_node_273b6f4a5ed4\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><style>\n  :root{\n    --bg-page:#f2f2f2;\n    --surface:#ffffff;\n    --ink:#1f1f1f;\n    --ink-soft:#606060;\n    --ink-faint:#a0a0a0;\n    --border:#e4e4e4;\n    --accent:#0e8f7e;\n    --accent-dark:#0a6d60;\n    --accent-soft:#ececec;\n    --accent-soft-border:#0e8f7e;\n    --flame-off:#d6d6d6;\n    --info-bg:#f2f2f2;\n    --info-ink:#1d3a63;\n    --info-icon:#3f7fd9;\n    --lesson-bg:#241f3d;\n    --lesson-accent:#f2a65a;\n    --overlay:rgba(31,31,31,0.55);\n    --radius-lg:20px;\n    --radius-md:12px;\n    --radius-sm:8px;\n    --font: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    --font-serif: Georgia, \"Times New Roman\", serif;\n  }\n\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    font-family: var(--font);\n    background:var(--bg-page);\n    color:var(--ink);\n    min-height:100vh;\n    position:relative;\n    overflow-x:hidden;\n  }\n\n  a{color:inherit;text-decoration:none;}\n  button{font-family:inherit;}\n\n  .icon{width:1em;height:1em;display:inline-block;vertical-align:middle;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}\n\n  /* ---------- background page (dimmed) ---------- */\n  .page{\n    filter:none;\n    position:relative;\n  }\n  .page::after{\n    content:\"\";\n    position:absolute;\n    inset:0;\n    background:var(--overlay);\n    z-index:5;\n  }\n\n  .topnav{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:22px 48px;\n    border-bottom:1px solid var(--border);\n    background:var(--surface);\n  }\n  .nav-left{display:flex;align-items:center;gap:44px;}\n  .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.35rem;color:var(--accent-dark);}\n  .brand .mark{\n    width:30px;height:30px;border-radius:8px;background:var(--accent);\n    color:#fff;display:flex;align-items:center;justify-content:center;\n    font-size:1rem;font-weight:800;\n  }\n  .nav-links{display:flex;gap:32px;font-size:1.05rem;font-weight:600;color:var(--ink-soft);}\n  .nav-links a.active{color:var(--accent-dark);position:relative;padding-bottom:4px;border-bottom:2px solid var(--ink);}\n  .nav-right{display:flex;align-items:center;gap:22px;}\n  .streak-chip{\n    display:flex;align-items:center;gap:6px;\n    background:var(--accent-soft);color:var(--accent-dark);\n    border-radius:999px;padding:6px 14px;font-weight:700;\n  }\n  .dropdown-pill{display:flex;align-items:center;gap:6px;font-weight:600;color:var(--ink-soft);}\n  .flag-circle{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#f2a65a,#0e8f7e);display:inline-block;}\n  .user-circle{width:26px;height:26px;border-radius:50%;background:var(--ink-faint);display:flex;align-items:center;justify-content:center;color:#fff;}\n\n  .page-body{padding:44px 48px 60px;}\n  .greeting{font-size:2.4rem;font-weight:700;margin:0 0 28px;}\n\n  .tabs{display:flex;gap:36px;border-bottom:1px solid var(--border);margin-bottom:28px;}\n  .tab{padding-bottom:14px;font-weight:700;font-size:1.1rem;color:var(--ink-faint);}\n  .tab.active{color:var(--ink);border-bottom:3px solid var(--ink);}\n\n  .workout-card{\n    background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-md);\n    padding:22px 26px;margin-bottom:34px;max-width:640px;\n  }\n  .workout-card .label{color:var(--ink-soft);font-size:.95rem;margin-bottom:6px;}\n  .workout-card .headline{font-size:1.35rem;font-weight:800;}\n\n  .unit-label{color:var(--ink-soft);font-size:1rem;margin-bottom:6px;}\n  .unit-headline{font-size:1.7rem;font-weight:800;margin-bottom:22px;max-width:640px;}\n\n  .lesson-card{\n    background:var(--lesson-bg);\n    border-radius:var(--radius-lg);\n    color:#fff;\n    padding:34px;\n    display:flex;\n    align-items:flex-end;\n    justify-content:space-between;\n    min-height:340px;\n    max-width:900px;\n    position:relative;\n    overflow:hidden;\n  }\n  .lesson-card .lesson-meta{position:absolute;top:28px;left:34px;font-size:1.05rem;color:#e2e2e2;}\n  .lesson-card .lesson-quote{position:absolute;top:60px;left:34px;right:34px;font-size:2rem;font-weight:800;line-height:1.2;}\n  .lesson-portrait{\n    width:220px;height:220px;border-radius:16px;\n    background:linear-gradient(160deg,#3a3160,#241f3d 70%);\n    margin-left:auto;\n  }\n  .lesson-nav-btn{\n    position:absolute;right:-24px;top:50%;transform:translateY(-50%);\n    width:48px;height:48px;border-radius:50%;background:#fff;color:var(--ink);\n    display:flex;align-items:center;justify-content:center;border:1px solid var(--border);\n    box-shadow:0 4px 12px rgba(0,0,0,.12);\n  }\n\n  .courses-heading{font-family:var(--font-serif);font-size:2.6rem;margin-top:52px;}\n\n  /* ---------- modal ---------- */\n  .modal-overlay{\n    position:fixed;inset:0;\n    display:flex;align-items:center;justify-content:center;\n    z-index:20;\n    padding:24px;\n  }\n  .modal{\n    background:var(--surface);\n    border-radius:var(--radius-lg);\n    width:100%;max-width:660px;\n    max-height:92vh;\n    overflow-y:auto;\n    padding:52px 56px 40px;\n    position:relative;\n    box-shadow:0 30px 80px rgba(0,0,0,.35);\n  }\n  .modal-close{\n    position:absolute;top:26px;right:26px;\n    width:40px;height:40px;border-radius:50%;\n    display:flex;align-items:center;justify-content:center;\n    background:transparent;border:none;color:var(--ink);cursor:pointer;\n  }\n  .modal-close:hover{background:var(--bg-page);}\n\n  .modal-title{\n    font-family:var(--font-serif);\n    font-size:2.7rem;\n    line-height:1.15;\n    text-align:center;\n    margin:0 0 18px;\n    font-weight:400;\n  }\n  .modal-title em{\n    color:var(--accent);\n    font-style:italic;\n    font-weight:700;\n  }\n  .modal-sub{\n    text-align:center;\n    color:var(--ink-soft);\n    font-size:1.1rem;\n    line-height:1.5;\n    max-width:440px;\n    margin:0 auto 34px;\n  }\n\n  .cal-header{\n    display:flex;align-items:center;justify-content:space-between;\n    margin-bottom:18px;\n  }\n  .cal-month{font-weight:800;font-size:1.2rem;}\n  .cal-nav{display:flex;gap:18px;color:var(--ink-faint);}\n  .cal-nav button{background:none;border:none;color:inherit;cursor:pointer;padding:4px;}\n  .cal-nav button.enabled{color:var(--ink);}\n\n  .cal-grid{\n    display:grid;\n    grid-template-columns:repeat(7,1fr);\n    gap:6px 4px;\n  }\n  .cal-dow{\n    text-align:center;font-weight:700;color:var(--ink-soft);font-size:.9rem;\n    padding-bottom:8px;\n  }\n  .cal-cell{\n    text-align:center;\n    padding:8px 2px 10px;\n    border-radius:var(--radius-sm);\n    border:1px solid transparent;\n  }\n  .cal-cell .day-num{font-weight:700;font-size:1rem;margin-bottom:6px;}\n  .cal-cell .flame{font-size:1.1rem;color:var(--flame-off);}\n  .cal-cell.empty{visibility:hidden;}\n  .cal-cell.active{\n    background:var(--accent-soft);\n    border-color:var(--accent-soft-border);\n  }\n  .cal-cell.active .day-num{color:var(--accent-dark);}\n  .cal-cell.active .flame{color:var(--accent);}\n  .cal-cell.today{\n    border-color:var(--accent-dark);\n    background:#fff;\n  }\n\n  .freeze-box{\n    display:flex;gap:16px;\n    background:var(--info-bg);\n    color:var(--info-ink);\n    border-radius:var(--radius-md);\n    padding:20px 22px;\n    margin-top:32px;\n  }\n  .freeze-box .icon{color:var(--info-icon);font-size:1.4rem;width:1.4em;height:1.4em;flex-shrink:0;margin-top:2px;}\n  .freeze-box .ftitle{font-weight:800;font-size:1.05rem;margin-bottom:4px;}\n  .freeze-box .ftext{font-size:.95rem;line-height:1.45;color:#33507a;}\n\n  @media (max-width: 720px){\n    .topnav{padding:16px 20px;}\n    .nav-links{display:none;}\n    .page-body{padding:26px 20px 40px;}\n    .greeting{font-size:1.7rem;}\n    .lesson-card{flex-direction:column;align-items:flex-start;padding:24px;min-height:auto;}\n    .lesson-portrait{width:100%;height:180px;margin-left:0;margin-top:70px;}\n    .lesson-card .lesson-quote{font-size:1.4rem;}\n    .courses-heading{font-size:2rem;}\n    .modal{padding:40px 20px 30px;}\n    .modal-title{font-size:2rem;}\n    .cal-cell .day-num{font-size:.85rem;}\n    .cal-cell .flame{font-size:.9rem;}\n  }\n</style>\n\n\n  <div class=\"page\">\n    <header class=\"topnav\">\n      <div class=\"nav-left\">\n        <div class=\"brand\"><span class=\"mark\">+V</span>Vesper</div>\n        <nav class=\"nav-links\">\n          <a href=\"#\" class=\"active\">Home</a>\n          <a href=\"#\">Review</a>\n          <a href=\"#\">Explore</a>\n        </nav>\n      </div>\n      <div class=\"nav-right\">\n        <div class=\"streak-chip\">\n          <svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"none\"><path d=\"M12 2c1 3-2 4-2 7a4 4 0 0 0 8 0c0-1-.5-2-.5-2 2 1 3 4 3 6a6.5 6.5 0 0 1-13 0c0-4 2-7 4.5-11Z\"></path></svg>\n          5\n        </div>\n        <div class=\"dropdown-pill\"><span class=\"flag-circle\"></span>\n          <svg class=\"icon\" viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\"></path></svg>\n        </div>\n        <div class=\"dropdown-pill\">\n          <span class=\"user-circle\">\n            <svg class=\"icon\" viewBox=\"0 0 24 24\" style=\"width:.7em;height:.7em;stroke:#fff\"><circle cx=\"12\" cy=\"8\" r=\"4\"></circle><path d=\"M4 20c0-4 4-6 8-6s8 2 8 6\"></path></svg>\n          </span>\n          <svg class=\"icon\" viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\"></path></svg>\n        </div>\n      </div>\n    </header>\n\n    <main class=\"page-body\">\n      <h1 class=\"greeting\">Hi there, Jordan Lane</h1>\n\n      <div class=\"tabs\">\n        <div class=\"tab active\">Today</div>\n        <div class=\"tab\">Study path</div>\n      </div>\n\n      <div class=\"workout-card\">\n        <div class=\"label\">Quick vocabulary drill</div>\n        <div class=\"headline\">Ready for a 3-minute refresher</div>\n      </div>\n\n      <div class=\"unit-label\">Explorer II (B1.1) · Unit 4</div>\n      <div class=\"unit-headline\">Order a meal and make small talk</div>\n\n      <div class=\"lesson-card\">\n        <div class=\"lesson-meta\">Lesson 3</div>\n        <div class=\"lesson-quote\">¿Podría traerme la cuenta, por favor?</div>\n        <div class=\"lesson-portrait\"></div>\n        <div class=\"lesson-nav-btn\">\n          <svg class=\"icon\" viewBox=\"0 0 24 24\"><path d=\"M9 6l6 6-6 6\"></path></svg>\n        </div>\n      </div>\n\n      <h2 class=\"courses-heading\">Programs</h2>\n    </main>\n  </div>\n\n  <div class=\"modal-overlay\">\n    <div class=\"modal\">\n      <button class=\"modal-close\" aria-label=\"Close\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" style=\"width:1.3em;height:1.3em;\"><path d=\"M6 6l12 12M18 6L6 18\"></path></svg>\n      </button>\n\n      <h2 class=\"modal-title\">You’re on a <em>5-day</em> streak</h2>\n      <p class=\"modal-sub\">Nice work! Practice a little every day and keep your streak alive.</p>\n\n      <div class=\"cal-header\">\n        <div class=\"cal-month\">October</div>\n        <div class=\"cal-nav\">\n          <button class=\"enabled\" aria-label=\"Previous month\">\n            <svg class=\"icon\" viewBox=\"0 0 24 24\"><path d=\"M15 6l-6 6 6 6\"></path></svg>\n          </button>\n          <button aria-label=\"Next month\" disabled=\"\">\n            <svg class=\"icon\" viewBox=\"0 0 24 24\"><path d=\"M9 6l6 6-6 6\"></path></svg>\n          </button>\n        </div>\n      </div>\n\n      <div class=\"cal-grid\">\n        <div class=\"cal-dow\">M</div><div class=\"cal-dow\">T</div><div class=\"cal-dow\">W</div>\n        <div class=\"cal-dow\">T</div><div class=\"cal-dow\">F</div><div class=\"cal-dow\">S</div><div class=\"cal-dow\">S</div>\n\n        <div class=\"cal-cell empty\"></div><div class=\"cal-cell empty\"></div>\n\n        <!-- 1-5 -->\n        <div class=\"cal-cell\"><div class=\"day-num\">1</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">2</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">3</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">4</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">5</div><div class=\"flame\">🔥</div></div>\n\n        <!-- 6-12 -->\n        <div class=\"cal-cell\"><div class=\"day-num\">6</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">7</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">8</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">9</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">10</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">11</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">12</div><div class=\"flame\">🔥</div></div>\n\n        <!-- 13-19, active 13-17 -->\n        <div class=\"cal-cell active\"><div class=\"day-num\">13</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell active\"><div class=\"day-num\">14</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell active\"><div class=\"day-num\">15</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell active\"><div class=\"day-num\">16</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell active today\"><div class=\"day-num\">17</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">18</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">19</div><div class=\"flame\">🔥</div></div>\n\n        <!-- 20-26 -->\n        <div class=\"cal-cell\"><div class=\"day-num\">20</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">21</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">22</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">23</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">24</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">25</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">26</div><div class=\"flame\">🔥</div></div>\n\n        <!-- 27-31 -->\n        <div class=\"cal-cell\"><div class=\"day-num\">27</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">28</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">29</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">30</div><div class=\"flame\">🔥</div></div>\n        <div class=\"cal-cell\"><div class=\"day-num\">31</div><div class=\"flame\">🔥</div></div>\n      </div>\n\n      <div class=\"freeze-box\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"none\"><path d=\"M12 2c2 3 4 5 4 8a4 4 0 0 1-8 0c0-3 2-5 4-8Z\"></path></svg>\n        <div>\n          <div class=\"ftitle\">3 Streak Shields left</div>\n          <div class=\"ftext\">You earn 2 Shields every Monday. They cover you automatically if you miss a day of practice.</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n\n\n",
