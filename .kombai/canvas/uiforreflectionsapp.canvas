ame=\"w2 day 8 cell\">\n                        <span class=\"pattern-mark bg-[var(--oxblood)]\" data-kid=\"1-4-1-3-2-2-1\" data-name=\"w2 d8 mark\">\n                        </span>\n                        <span class=\"pattern-writing\" data-kid=\"1-4-1-3-2-2-2\" data-name=\"w2 d8 writing indicator\">\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-2-2-3\" data-name=\"w2 d8 day number\">\n                            8\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-2-3\" data-name=\"w2 day 9 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-2-3-1\" data-name=\"w2 d9 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-2-3-2\" data-name=\"w2 d9 day number\">\n                            9\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-2-4\" data-name=\"w2 day 10 cell\">\n                        <span class=\"pattern-mark bg-[var(--ochre)]\" data-kid=\"1-4-1-3-2-4-1\" data-name=\"w2 d10 mark\">\n                        </span>\n                        <span class=\"pattern-writing\" data-kid=\"1-4-1-3-2-4-2\" data-name=\"w2 d10 writing indicator\">\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-2-4-3\" data-name=\"w2 d10 day number\">\n                            10\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-2-5\" data-name=\"w2 day 11 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-2-5-1\" data-name=\"w2 d11 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-2-5-2\" data-name=\"w2 d11 day number\">\n                            11\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-2-6\" data-name=\"w2 day 12 cell\">\n                        <span class=\"pattern-mark bg-[var(--espresso)]\" data-kid=\"1-4-1-3-2-6-1\" data-name=\"w2 d12 mark\">\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-2-6-2\" data-name=\"w2 d12 day number\">\n                            12\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-2-7\" data-name=\"w2 day 13 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-2-7-1\" data-name=\"w2 d13 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-2-7-2\" data-name=\"w2 d13 day number\">\n                            13\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-2-8\" data-name=\"w2 day 14 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-2-8-1\" data-name=\"w2 d14 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-2-8-2\" data-name=\"w2 d14 day number\">\n                            14\n                        </span>\n                    </div>\n                </div>\n                <div class=\"pattern-week\" data-kid=\"1-4-1-3-3\" data-name=\"pattern week 3\">\n                    <span class=\"pt-2 text-[9px] font-semibold uppercase text-[var(--lichen)]\" data-kid=\"1-4-1-3-3-1\" data-name=\"week 3 label\">\n                        W3\n                    </span>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-3-2\" data-name=\"w3 day 15 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-3-2-1\" data-name=\"w3 d15 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-3-2-2\" data-name=\"w3 d15 day number\">\n                            15\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-3-3\" data-name=\"w3 day 16 cell\">\n                        <span class=\"pattern-mark bg-[var(--lichen)]\" data-kid=\"1-4-1-3-3-3-1\" data-name=\"w3 d16 mark\">\n                        </span>\n                        <span class=\"pattern-writing\" data-kid=\"1-4-1-3-3-3-2\" data-name=\"w3 d16 writing indicator\">\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-3-3-3\" data-name=\"w3 d16 day number\">\n                            16\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-3-4\" data-name=\"w3 day 17 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-3-4-1\" data-name=\"w3 d17 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-3-4-2\" data-name=\"w3 d17 day number\">\n                            17\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-3-5\" data-name=\"w3 day 18 cell\">\n                        <span class=\"pattern-mark bg-[var(--oxblood)]\" data-kid=\"1-4-1-3-3-5-1\" data-name=\"w3 d18 mark\">\n                        </span>\n                        <span class=\"pattern-writing\" data-kid=\"1-4-1-3-3-5-2\" data-name=\"w3 d18 writing indicator\">\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-3-5-3\" data-name=\"w3 d18 day number\">\n                            18\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-3-6\" data-name=\"w3 day 19 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-3-6-1\" data-name=\"w3 d19 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-3-6-2\" data-name=\"w3 d19 day number\">\n                            19\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-3-7\" data-name=\"w3 day 20 cell\">\n                        <span class=\"pattern-mark bg-[var(--ochre)]\" data-kid=\"1-4-1-3-3-7-1\" data-name=\"w3 d20 mark\">\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-3-7-2\" data-name=\"w3 d20 day number\">\n                            20\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-3-8\" data-name=\"w3 day 21 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-3-8-1\" data-name=\"w3 d21 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-3-8-2\" data-name=\"w3 d21 day number\">\n                            21\n                        </span>\n                    </div>\n                </div>\n                <div class=\"pattern-week\" data-kid=\"1-4-1-3-4\" data-name=\"pattern week 4\">\n                    <span class=\"pt-2 text-[9px] font-semibold uppercase text-[var(--lichen)]\" data-kid=\"1-4-1-3-4-1\" data-name=\"week 4 label\">\n                        W4\n                    </span>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-4-2\" data-name=\"w4 day 22 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-4-2-1\" data-name=\"w4 d22 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-4-2-2\" data-name=\"w4 d22 day number\">\n                            22\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-4-3\" data-name=\"w4 day 23 cell\">\n                        <span class=\"pattern-mark bg-[var(--lichen)]\" data-kid=\"1-4-1-3-4-3-1\" data-name=\"w4 d23 mark\">\n                        </span>\n                        <span class=\"pattern-writing\" data-kid=\"1-4-1-3-4-3-2\" data-name=\"w4 d23 writing indicator\">\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-4-3-3\" data-name=\"w4 d23 day number\">\n                            23\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-4-4\" data-name=\"w4 day 24 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-4-4-1\" data-name=\"w4 d24 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-4-4-2\" data-name=\"w4 d24 day number\">\n                            24\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-4-5\" data-name=\"w4 day 25 cell\">\n                        <span class=\"pattern-mark bg-[var(--oxblood)]\" data-kid=\"1-4-1-3-4-5-1\" data-name=\"w4 d25 mark\">\n                        </span>\n                        <span class=\"pattern-writing\" data-kid=\"1-4-1-3-4-5-2\" data-name=\"w4 d25 writing indicator\">\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-4-5-3\" data-name=\"w4 d25 day number\">\n                            25\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-4-6\" data-name=\"w4 day 26 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-4-6-1\" data-name=\"w4 d26 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-4-6-2\" data-name=\"w4 d26 day number\">\n                            26\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-4-7\" data-name=\"w4 day 27 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-4-7-1\" data-name=\"w4 d27 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-4-7-2\" data-name=\"w4 d27 day number\">\n                            27\n                        </span>\n                    </div>\n                    <div class=\"pattern-cell flex flex-col items-center justify-start pt-1\" data-kid=\"1-4-1-3-4-8\" data-name=\"w4 day 28 cell\">\n                        <span class=\"pattern-gap\" data-kid=\"1-4-1-3-4-8-1\" data-name=\"w4 d28 gap icon\">\n                            —\n                        </span>\n                        <span class=\"text-[9px]\" data-kid=\"1-4-1-3-4-8-2\" data-name=\"w4 d28 day number\">\n                            28\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <p class=\"mt-4 text-[11px] text-[var(--lichen)]\" data-kid=\"1-4-1-4\" data-name=\"summary statistics text\">\n                12 check-ins · 10 reflections\n            </p>\n        </div>\n    </section>\n    <section aria-labelledby=\"reminder-title\" class=\"mt-8 px-3 pb-2\" data-kid=\"1-5\" data-name=\"reminder section\">\n        <div class=\"border-b border-[var(--espresso)] pb-6\" data-kid=\"1-5-1\" data-name=\"reminder content container\">\n            <p class=\"mb-3 text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--lichen)]\" data-kid=\"1-5-1-1\" data-name=\"reminder title\" id=\"reminder-title\">\n                Reminder\n            </p>\n            <div class=\"flex items-center justify-between border border-[var(--edge)] px-4 py-3\" data-kid=\"1-5-1-2\" data-name=\"reminder control row\">\n                <div data-kid=\"1-5-1-2-1\" data-name=\"reminder time detail\">\n                    <p class=\"text-[13px] font-semibold\" data-kid=\"1-5-1-2-1-1\" data-name=\"reminder name\">\n                        Daily reminder\n                    </p>\n                    <p class=\"mt-1 flex items-center gap-2 text-[12px] text-[var(--lichen)]\" data-kid=\"1-5-1-2-1-2\" data-name=\"reminder time indicator\">\n                        <i aria-hidden=\"true\" class=\"ti ti-clock text-[15px]\" data-kid=\"1-5-1-2-1-2-1\" data-name=\"clock icon\" style=\"color:var(--lichen);width:15px;height:15px\">\n                        </i>\n                        8:30 PM\n                    </p>\n                </div>\n                <button aria-pressed=\"true\" class=\"h-8 min-w-[49px] border-2 border-[var(--espresso)] px-2 text-[10px] font-semibold uppercase tracking-[0.14em]\" data-dynamic=\"true\" data-kid=\"1-5-1-2-2\" data-name=\"reminder toggle button\" data-reason=\"text updated via script on toggle\" id=\"reminder-toggle\" type=\"button\">\n                    <span data-dynamic=\"true\" data-kid=\"1-5-1-2-2-1\" data-name=\"reminder toggle state label\" data-reason=\"text updated via script on toggle\" id=\"reminder-state\">\n                        ON\n                    </span>\n                </button>\n            </div>\n        </div>\n    </section>\n</main>\n<nav aria-label=\"Folio sections\" class=\"sticky inset-x-0 bottom-0 z-50 mt-1 h-[60px] border-t border-[var(--espresso)] bg-[var(--edge)]\" data-kid=\"2\" data-name=\"main navigation bar\">\n    <div class=\"mx-auto grid h-full max-w-[375px] grid-cols-4 px-2\" data-kid=\"2-1\" data-name=\"nav link container\">\n        <button aria-current=\"page\" class=\"folio-nav-active flex w-full items-center justify-center whitespace-nowrap text-[11px] font-semibold text-[var(--espresso)]\" data-kid=\"2-1-1\" data-name=\"today navigation link\" type=\"button\">\n            Today\n        </button>\n        <button class=\"flex h-[60px] w-full items-center justify-center whitespace-nowrap text-[11px] font-semibold text-[var(--espresso)]\" data-kid=\"2-1-2\" data-name=\"history navigation link\" type=\"button\">\n            History\n        </button>\n        <button class=\"flex h-[60px] w-full items-center justify-center whitespace-nowrap text-[11px] font-semibold text-[var(--espresso)]\" data-kid=\"2-1-3\" data-name=\"patterns navigation link\" type=\"button\">\n            Patterns\n        </button>\n        <button class=\"flex h-[60px] w-full items-center justify-center whitespace-nowrap text-[11px] font-semibold text-[var(--espresso)]\" data-kid=\"2-1-4\" data-name=\"reminder navigation link\" type=\"button\">\n            Reminder\n        </button>\n    </div>\n</nav>\n<script>\n    const moodButtons = document.querySelectorAll('.mood-tongue');\n  const moodConfirmation = document.querySelector('#mood-confirmation');\n  moodButtons.forEach((button) => {\n    button.addEventListener('click', () => {\n      moodButtons.forEach((item) => {\n        item.classList.remove('is-selected');\n        item.setAttribute('aria-pressed', 'false');\n      });\n      button.classList.add('is-selected');\n      button.setAttribute('aria-pressed', 'true');\n      moodConfirmation.textContent = `Mood set to ${button.dataset.mood}.`;\n    });\n  });\n\n  const reflection = document.querySelector('#reflection');\n  const autosaveNote = document.querySelector('#autosave-note');\n  reflection.addEventListener('input', () => {\n    autosaveNote.textContent = '• saved automatically · just now';\n  });\n\n  const saveReflection = document.querySelector('#save-reflection');\n  saveReflection.addEventListener('click', () => {\n    saveReflection.textContent = 'Saved for today';\n  });\n\n  const reminderToggle = document.querySelector('#reminder-toggle');\n  const reminderState = document.querySelector('#reminder-state');\n  reminderToggle.addEventListener('click', () => {\n    const enabled = reminderToggle.getAttribute('aria-pressed') === 'true';\n    reminderToggle.setAttribute('aria-pressed', String(!enabled));\n    reminderState.textContent = enabled ? 'OFF' : 'ON';\n  });\n</script>\n",
      "comments": [],
      "created": "2026-09-01T08:01:17.762593+00:00",
      "modified": "2026-09-01T08:01:17.762593+00:00",
      "id": "var_d0c28c98d55a"
    },
    "var_820904adefe5": {
      "type": "variant",
      "label": "Mood Trace — Daily Reflection Concept",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1816,
        "y": 334,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Golos+Text:wght@400;500;600;700&display=swap');\n\n  .mt-shell {\n    --mt-albite: #F1F4F2;\n    --mt-ink: #15201E;\n    --mt-teal: #285A60;\n    --mt-coral: #D75A45;\n    --mt-muted: #899792;\n    --mt-paper: #FFFFFF;\n    --mt-soft-rule: color-mix(in srgb, var(--mt-teal) 44%, transparent);\n    --mt-faint-ink: color-mix(in srgb, var(--mt-ink) 62%, transparent);\n  }\n\n  .mt-ui { font-family: 'Golos Text', sans-serif; }\n  .mt-mono { font-family: 'Fragment Mono', monospace; }\n  .mt-rule-soft { border-color: var(--mt-soft-rule); }\n  .mt-registration-line { background: var(--mt-teal); }\n  .mt-cross-tick { left: -4px; width: 8px; }\n  .mt-trace-segment { stroke-dasharray: 520; animation: mt-trace-draw 1.1s cubic-bezier(.22,.7,.26,1) both; }\n  .mt-trace-segment:nth-of-type(2) { animation-delay: .12s; }\n  .mt-trace-segment:nth-of-type(3) { animation-delay: .24s; }\n  .mt-trace-segment:nth-of-type(4) { animation-delay: .36s; }\n  @keyframes mt-trace-draw { from { stroke-dashoffset: 520; } to { stroke-dashoffset: 0; } }\n  .mood-row.is-selected .mood-label { font-weight: 600; color: var(--mt-ink); }\n  .mood-row.is-selected .mood-state { color: var(--mt-coral); }\n  .calendar-day.is-selected { outline: 2px solid var(--mt-coral); outline-offset: -2px; z-index: 1; }\n  .calendar-day.is-selected .calendar-date { color: var(--mt-coral); font-weight: 600; }\n  .range-tab.is-active { color: var(--mt-ink); border-color: var(--mt-coral); font-weight: 600; }\n  .range-tab:not(.is-active) { color: var(--mt-muted); }\n  .nav-item.is-active { color: var(--mt-coral); }\n  .nav-item.is-active .nav-marker { background: var(--mt-coral); }\n  .reminder-toggle.is-off { color: var(--mt-muted); border-color: var(--mt-soft-rule); }\n  .mt-plot-grid { stroke: var(--mt-soft-rule); stroke-width: 1; vector-effect: non-scaling-stroke; }\n  .mt-plot-trace { fill: none; stroke: var(--mt-teal); stroke-width: 1.5; stroke-linecap: square; stroke-linejoin: miter; vector-effect: non-scaling-stroke; }\n  .mt-plot-current { fill: var(--mt-coral); }\n</style>\n<div class=\"mt-shell mt-ui min-h-screen w-full overflow-x-clip bg-[var(--mt-albite)] text-[var(--mt-ink)]\" data-kid=\"1\" data-name=\"mood trace application container\" id=\"mood-trace\">\n    <main class=\"mx-auto w-full max-w-[375px] pb-[98px]\" data-kid=\"1-1\" data-name=\"main content layout\">\n        <div class=\"relative px-5 scroll-mt-4\" data-kid=\"1-1-1\" data-name=\"today view section\" id=\"today\">\n            <span class=\"pointer-events-none absolute left-5 top-[122px] bottom-0 z-20 w-px mt-registration-line\" data-kid=\"1-1-1-1\" data-name=\"vertical registration line\">\n            </span>\n            <header class=\"pt-5\" data-kid=\"1-1-1-2\" data-name=\"header section\">\n                <div class=\"border-t border-[var(--mt-teal)] pt-3\" data-kid=\"1-1-1-2-1\" data-name=\"header top content block\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-1-1-2-1-1\" data-name=\"brand and page info wrapper\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"brand logo and label container\">\n                            <span class=\"h-2 w-2 bg-[var(--mt-coral)]\" data-kid=\"1-1-1-2-1-1-1-1\" data-name=\"brand accent square\">\n                            </span>\n                            <span class=\"mt-mono text-[10px] uppercase tracking-[.17em] text-[var(--mt-teal)]\" data-kid=\"1-1-1-2-1-1-1-2\" data-name=\"brand label text\">\n                                Mood Trace\n                            </span>\n                        </div>\n                        <span class=\"mt-mono text-[9px] uppercase tracking-[.12em] text-[var(--mt-muted)]\" data-kid=\"1-1-1-2-1-1-2\" data-name=\"page status label\">\n                            Daily observation\n                        </span>\n                    </div>\n                    <div class=\"mt-6 flex items-end justify-between\" data-kid=\"1-1-1-2-1-2\" data-name=\"headline and streak info wrapper\">\n                        <div data-kid=\"1-1-1-2-1-2-1\" data-name=\"headline container\">\n                            <h1 class=\"text-[39px] font-semibold leading-[.9] tracking-[-.065em]\" data-kid=\"1-1-1-2-1-2-1-1\" data-name=\"today headline\">\n                                Today\n                            </h1>\n                            <p class=\"mt-3 mt-mono text-[11px] uppercase tracking-[.08em] text-[var(--mt-muted)]\" data-kid=\"1-1-1-2-1-2-1-2\" data-name=\"today date label\">\n                                Tuesday, Sep 1\n                            </p>\n                        </div>\n                        <div class=\"flex items-end gap-2 pb-0.5\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"streak info container\">\n                            <span class=\"mt-mono text-[31px] leading-none text-[var(--mt-teal)]\" data-kid=\"1-1-1-2-1-2-2-1\" data-name=\"streak count number\">\n                                6\n                            </span>\n                            <span class=\"mb-0.5 w-[72px] text-[10px] leading-[1.15] text-[var(--mt-muted)]\" data-kid=\"1-1-1-2-1-2-2-2\" data-name=\"streak label text\">\n                                days in a row\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"relative mt-6 border-y border-[var(--mt-teal)] py-3\" data-kid=\"1-1-1-2-2\" data-name=\"fourteen day trace container\">\n                    <span class=\"mt-cross-tick pointer-events-none absolute top-1/2 h-px bg-[var(--mt-teal)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"section accent tick\">\n                    </span>\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-1-1-2-2-2\" data-name=\"trace header labels\">\n                        <span class=\"mt-mono text-[9px] uppercase tracking-[.13em] text-[var(--mt-teal)]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"trace type label\">\n                            14-day trace\n                        </span>\n                        <span class=\"mt-mono text-[9px] uppercase tracking-[.1em] text-[var(--mt-muted)]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"trace subtitle label\">\n                            check-ins\n                        </span>\n                    </div>\n                    <svg aria-label=\"A fourteen day mood trace with visible gaps\" class=\"mt-2 h-[74px] w-full overflow-visible\" data-kid=\"1-1-1-2-2-3\" data-name=\"mood trace svg\" role=\"img\" viewbox=\"0 0 335 74\">\n                        <path class=\"mt-trace-segment\" d=\"M7 56 H31 V45 H55\" fill=\"none\" stroke=\"var(--mt-teal)\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"1.35\">\n                        </path>\n                        <path class=\"mt-trace-segment\" d=\"M103 45 H127 V33 H151 V42 H175\" fill=\"none\" stroke=\"var(--mt-teal)\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"1.35\">\n                        </path>\n                        <path class=\"mt-trace-segment\" d=\"M199 42 H223 V20 H247 V30 H271\" fill=\"none\" stroke=\"var(--mt-teal)\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"1.35\">\n                        </path>\n                        <path class=\"mt-trace-segment\" d=\"M295 30 H319 V42 H331\" fill=\"none\" stroke=\"var(--mt-teal)\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"1.35\">\n                        </path>\n                        <circle cx=\"331\" cy=\"42\" fill=\"var(--mt-coral)\" r=\"3.2\">\n                        </circle>\n                    </svg>\n                    <div class=\"flex items-center justify-between gap-2 mt-mono text-[9px] u