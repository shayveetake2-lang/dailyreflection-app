    "inspiration_node_bb1d8e847480": {
      "type": "variant",
      "id": "inspiration_node_bb1d8e847480",
      "label": "Loopli",
      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19758/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/uiforreflectionsapp.canvas\", nodeId: \"inspiration_node_bb1d8e847480\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><style>\n  :root {\n    --primary: #7c3aed;\n    --primary-dark: #5b21b6;\n    --primary-light: #a78bfa;\n    --bg-deep: #3b0f8f;\n    --bg-mid: #6d28d9;\n    --bg-shine: #a855f7;\n    --surface: #ffffff;\n    --text-main: #1a1523;\n    --text-sub: #5c5468;\n    --border: #e6e1ee;\n    --radius-card: 20px;\n    --radius-field: 12px;\n    --font-sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  * { box-sizing: border-box; }\n\n  html, body {\n    margin: 0;\n    padding: 0;\n    font-family: var(--font-sans);\n    color: var(--text-main);\n  }\n\n  body {\n    min-height: 100vh;\n    position: relative;\n    overflow-x: hidden;\n    background:\n      radial-gradient(circle at 15% 20%, var(--bg-shine) 0%, transparent 40%),\n      radial-gradient(circle at 85% 15%, var(--primary-light) 0%, transparent 35%),\n      radial-gradient(circle at 80% 85%, var(--bg-shine) 0%, transparent 45%),\n      radial-gradient(circle at 10% 85%, var(--primary-light) 0%, transparent 40%),\n      linear-gradient(160deg, var(--bg-mid) 0%, var(--bg-deep) 100%);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  /* decorative floating shapes -- playful scattered collage, reskinned */\n  .deco {\n    position: absolute;\n    border-radius: 28%;\n    background: linear-gradient(145deg, rgba(255,255,255,0.28), rgba(255,255,255,0.02));\n    box-shadow: inset -6px -8px 16px rgba(20,4,60,0.35), inset 6px 6px 14px rgba(255,255,255,0.25);\n    pointer-events: none;\n    z-index: 0;\n  }\n  .deco.circle { border-radius: 50%; }\n  .deco.d1 { width: 190px; height: 190px; top: -60px; left: 4%; border-radius: 50%; }\n  .deco.d2 { width: 130px; height: 130px; top: 6%; left: 22%; transform: rotate(20deg); }\n  .deco.d3 { width: 260px; height: 260px; top: -5%; right: 6%; border-radius: 50%; }\n  .deco.d4 { width: 100px; height: 100px; top: 30%; left: 6%; border-radius: 50%; }\n  .deco.d5 { width: 150px; height: 150px; top: 46%; right: 3%; transform: rotate(-12deg); }\n  .deco.d6 { width: 220px; height: 220px; bottom: -8%; left: 12%; border-radius: 50%; }\n  .deco.d7 { width: 170px; height: 170px; bottom: -6%; right: 16%; transform: rotate(12deg); }\n  .deco.d8 { width: 90px; height: 90px; bottom: 20%; left: 40%; border-radius: 50%; }\n  .deco.d9 { width: 120px; height: 120px; bottom: 8%; right: 40%; transform: rotate(-20deg); }\n  .deco.d10 { width: 80px; height: 80px; top: 62%; left: 2%; border-radius: 50%; }\n\n  @media (max-width: 700px) {\n    .deco { display: none; }\n  }\n\n  .brand {\n    position: relative;\n    z-index: 2;\n    margin-top: 56px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .brand-mark {\n    width: 40px;\n    height: 40px;\n    border-radius: 10px;\n    background: var(--surface);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .brand-mark svg { width: 22px; height: 22px; }\n\n  .brand-word {\n    font-size: 34px;\n    font-weight: 800;\n    letter-spacing: 1px;\n    color: #ffffff;\n    font-family: \"Segoe UI\", var(--font-sans);\n  }\n\n  .card {\n    position: relative;\n    z-index: 2;\n    margin: 48px 20px 80px;\n    width: 100%;\n    max-width: 460px;\n    background: var(--surface);\n    border-radius: var(--radius-card);\n    box-shadow: 0 30px 70px rgba(30, 10, 70, 0.35);\n    padding: 36px 36px 32px;\n  }\n\n  .card h1 {\n    margin: 0 0 8px;\n    font-size: 26px;\n    font-weight: 700;\n    letter-spacing: -0.3px;\n  }\n\n  .card p.sub {\n    margin: 0 0 24px;\n    font-size: 15px;\n    color: var(--text-sub);\n    line-height: 1.5;\n  }\n\n  .oauth-btn {\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    padding: 13px 16px;\n    border-radius: 999px;\n    border: 1px solid var(--border);\n    background: var(--surface);\n    font-size: 15px;\n    font-weight: 600;\n    color: var(--text-main);\n    cursor: pointer;\n    margin-bottom: 12px;\n    transition: background 0.15s ease, border-color 0.15s ease;\n  }\n\n  .oauth-btn:hover {\n    background: #faf9fc;\n    border-color: #d6cfe4;\n  }\n\n  .oauth-btn svg { width: 18px; height: 18px; flex-shrink: 0; }\n\n  .divider {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin: 22px 0 22px;\n  }\n\n  .divider .line {\n    flex: 1;\n    height: 1px;\n    background: var(--border);\n  }\n\n  .divider span {\n    font-size: 12px;\n    font-weight: 600;\n    color: var(--text-sub);\n    letter-spacing: 0.5px;\n  }\n\n  .field label {\n    display: block;\n    font-size: 13px;\n    font-weight: 700;\n    margin-bottom: 8px;\n  }\n\n  .field input {\n    width: 100%;\n    padding: 13px 14px;\n    border-radius: var(--radius-field);\n    border: 1px solid var(--border);\n    font-size: 15px;\n    font-family: inherit;\n    color: var(--text-main);\n    background: #fff;\n    outline: none;\n  }\n\n  .field input:focus {\n    border-color: var(--primary);\n    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);\n  }\n\n  .continue-btn {\n    width: 100%;\n    margin-top: 22px;\n    padding: 14px 16px;\n    border: none;\n    border-radius: 999px;\n    background: var(--primary);\n    color: #fff;\n    font-size: 16px;\n    font-weight: 700;\n    cursor: pointer;\n    transition: background 0.15s ease;\n  }\n\n  .continue-btn:hover {\n    background: var(--primary-dark);\n  }\n\n  .legal {\n    margin: 18px 0 0;\n    text-align: center;\n    font-size: 12.5px;\n    color: var(--text-sub);\n    line-height: 1.6;\n  }\n\n  .legal a {\n    color: var(--primary);\n    font-weight: 700;\n    text-decoration: none;\n  }\n\n  .legal a:hover { text-decoration: underline; }\n\n  @media (max-width: 480px) {\n    .card { padding: 28px 22px 26px; }\n    .brand-word { font-size: 28px; }\n    .card h1 { font-size: 22px; }\n  }\n</style>\n\n\n  <div class=\"deco circle d1\"></div>\n  <div class=\"deco d2\"></div>\n  <div class=\"deco circle d3\"></div>\n  <div class=\"deco circle d4\"></div>\n  <div class=\"deco d5\"></div>\n  <div class=\"deco circle d6\"></div>\n  <div class=\"deco d7\"></div>\n  <div class=\"deco circle d8\"></div>\n  <div class=\"deco d9\"></div>\n  <div class=\"deco circle d10\"></div>\n\n  <div class=\"brand\">\n    <div class=\"brand-mark\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <circle cx=\"8\" cy=\"12\" r=\"5.5\" stroke=\"#7c3aed\" stroke-width=\"2.2\"></circle>\n        <circle cx=\"16\" cy=\"12\" r=\"5.5\" stroke=\"#7c3aed\" stroke-width=\"2.2\"></circle>\n      </svg>\n    </div>\n    <div class=\"brand-word\">loopli</div>\n  </div>\n\n  <main class=\"card\">\n    <h1>Create your account</h1>\n    <p class=\"sub\">Loopli is way more fun with your crew along for the ride.</p>\n\n    <button class=\"oauth-btn\" type=\"button\">\n      <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path fill=\"#4285F4\" d=\"M23.49 12.27c0-.79-.07-1.54-.2-2.27H12v4.3h6.47c-.28 1.5-1.13 2.77-2.4 3.62v3h3.88c2.27-2.09 3.58-5.17 3.58-8.65z\"></path>\n        <path fill=\"#34A853\" d=\"M12 24c3.24 0 5.95-1.07 7.93-2.9l-3.88-3c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.76-2.1-6.7-4.93H1.3v3.09C3.26 21.3 7.31 24 12 24z\"></path>\n        <path fill=\"#FBBC05\" d=\"M5.3 14.33c-.24-.72-.38-1.49-.38-2.28s.14-1.56.38-2.28V6.68H1.3A11.96 11.96 0 000 12.05c0 1.94.46 3.77 1.3 5.37l4-3.09z\"></path>\n        <path fill=\"#EA4335\" d=\"M12 4.75c1.76 0 3.34.6 4.58 1.79l3.44-3.44C17.94 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.3 6.68l4 3.09c.94-2.83 3.58-4.93 6.7-4.93z\"></path>\n      </svg>\n      Continue with Google\n    </button>\n\n    <button class=\"oauth-btn\" type=\"button\">\n      <svg viewBox=\"0 0 24 24\" fill=\"#111\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M16.36 1.43c0 1.14-.42 2.2-1.24 3.03-.85.87-2.02 1.5-3.16 1.4-.13-1.09.42-2.24 1.2-3.02.83-.87 2.27-1.53 3.2-1.41zM20.6 17.34c-.5 1.16-.75 1.68-1.4 2.71-.91 1.43-2.2 3.22-3.79 3.24-1.42.02-1.78-.92-3.7-.91-1.92.01-2.32.93-3.75.91-1.6-.02-2.82-1.62-3.73-3.05-2.57-4-2.84-8.69-1.26-11.2.93-1.48 2.5-2.4 4-2.42 1.55-.03 2.53.98 3.7.98 1.16 0 2.13-.99 3.87-.98.72.03 2.74.29 4.03 2.2-.1.07-2.4 1.4-2.38 4.2.03 3.34 2.94 4.44 2.41 4.32z\"></path>\n      </svg>\n      Continue with Apple\n    </button>\n\n    <div class=\"divider\">\n      <div class=\"line\"></div>\n      <span>OR</span>\n      <div class=\"line\"></div>\n    </div>\n\n    <div class=\"field\">\n      <label for=\"email\">Email</label>\n      <input id=\"email\" type=\"email\" value=\"jordan.lee+demo@loopli.io\">\n    </div>\n\n    <button class=\"continue-btn\" type=\"button\">Continue</button>\n\n    <p class=\"legal\">\n      By continuing, you agree to loopli's <a href=\"#\">Terms of Service</a> and\n      acknowledge you've read our <a href=\"#\">Privacy Policy</a>.\n    </p>\n  </main>\n\n\n\n",
