\n                    </div>\n                    <i aria-hidden=\"true\" class=\"ti ti-chart-no-axes-column-increasing shrink-0 text-[var(--mt-teal)]\" data-kid=\"1-1-3-1-1-2\" data-name=\"patterns chart icon\" style=\"color:var(--mt-teal);width:22px;height:22px;font-size:22px;line-height:22px\">\n                    </i>\n                </div>\n                <p class=\"mt-5 max-w-[305px] text-[16px] leading-[1.35] tracking-[-.015em]\" data-kid=\"1-1-3-1-2\" data-name=\"patterns summary text\">\n                    Your check-ins were mostly Steady this week.\n                </p>\n            </div>\n            <div class=\"mt-5 flex gap-5 border-y border-[var(--mt-teal)] px-5 mt-mono text-[10px] uppercase tracking-[.06em]\" data-kid=\"1-1-3-2\" data-name=\"patterns timeframe tabs container\">\n                <button aria-selected=\"true\" class=\"range-tab is-active border-b-2 py-3 text-left\" data-kid=\"1-1-3-2-1\" data-name=\"seven day tab\" data-range=\"7\" type=\"button\">\n                    7 days\n                </button>\n                <button aria-selected=\"false\" class=\"range-tab border-b-2 border-transparent py-3 text-left\" data-kid=\"1-1-3-2-2\" data-name=\"thirty day tab\" data-range=\"30\" type=\"button\">\n                    30 days\n                </button>\n                <button aria-selected=\"false\" class=\"range-tab border-b-2 border-transparent py-3 text-left\" data-kid=\"1-1-3-2-3\" data-name=\"three month tab\" data-range=\"3m\" type=\"button\">\n                    3 months\n                </button>\n            </div>\n            <div class=\"mt-6 px-5\" data-kid=\"1-1-3-3\" data-name=\"patterns chart container\">\n                <div class=\"grid grid-cols-[58px_1fr] gap-3\" data-kid=\"1-1-3-3-1\" data-name=\"patterns chart layout\">\n                    <div class=\"flex h-[174px] flex-col justify-between pt-0.5 mt-mono text-[8px] uppercase leading-none tracking-[-.02em] text-[var(--mt-muted)]\" data-kid=\"1-1-3-3-1-1\" data-name=\"patterns y axis labels\">\n                        <span data-kid=\"1-1-3-3-1-1-1\">\n                            Energized\n                        </span>\n                        <span data-kid=\"1-1-3-3-1-1-2\">\n                            Light\n                        </span>\n                        <span data-kid=\"1-1-3-3-1-1-3\">\n                            Steady\n                        </span>\n                        <span data-kid=\"1-1-3-3-1-1-4\">\n                            Low\n                        </span>\n                        <span data-kid=\"1-1-3-3-1-1-5\">\n                            Drained\n                        </span>\n                    </div>\n                    <div data-kid=\"1-1-3-3-1-2\" data-name=\"patterns chart content\">\n                        <div class=\"relative h-[174px] border-b border-l border-[var(--mt-teal)]\" data-kid=\"1-1-3-3-1-2-1\" data-name=\"patterns svg plot area\">\n                            <svg aria-label=\"Step plot of mood labels with gaps\" class=\"absolute inset-0 h-full w-full overflow-visible\" data-kid=\"1-1-3-3-1-2-1-1\" data-name=\"patterns svg\" preserveaspectratio=\"none\" role=\"img\" viewbox=\"0 0 246 174\">\n                                <line class=\"mt-plot-grid\" x1=\"0\" x2=\"246\" y1=\"7\" y2=\"7\">\n                                </line>\n                                <line class=\"mt-plot-grid\" x1=\"0\" x2=\"246\" y1=\"47\" y2=\"47\">\n                                </line>\n                                <line class=\"mt-plot-grid\" x1=\"0\" x2=\"246\" y1=\"87\" y2=\"87\">\n                                </line>\n                                <line class=\"mt-plot-grid\" x1=\"0\" x2=\"246\" y1=\"127\" y2=\"127\">\n                                </line>\n                                <line class=\"mt-plot-grid\" x1=\"0\" x2=\"246\" y1=\"167\" y2=\"167\">\n                                </line>\n                                <g data-plot=\"7\">\n                                    <path class=\"mt-plot-trace\" d=\"M5 87 H30 V47 H54 M82 87 H108 V87 H133 M160 87 H187 V127 H211 M232 87 H241\">\n                                    </path>\n                                    <circle class=\"mt-plot-current\" cx=\"241\" cy=\"87\" r=\"3.2\">\n                                    </circle>\n                                </g>\n                                <g data-plot=\"30\" hidden=\"\">\n                                    <path class=\"mt-plot-trace\" d=\"M4 127 H17 V87 H30 V87 H43 M62 87 H77 V47 H93 V87 H109 M128 87 H143 V87 H157 M176 87 H191 V127 H207 M224 87 H241\">\n                                    </path>\n                                    <circle class=\"mt-plot-current\" cx=\"241\" cy=\"87\" r=\"3.2\">\n                                    </circle>\n                                </g>\n                                <g data-plot=\"3m\" hidden=\"\">\n                                    <path class=\"mt-plot-trace\" d=\"M4 47 H17 V87 H31 M51 87 H66 V127 H80 M104 87 H121 V47 H139 M159 47 H174 V87 H190 M213 87 H228 V87 H241\">\n                                    </path>\n                                    <circle class=\"mt-plot-current\" cx=\"241\" cy=\"87\" r=\"3.2\">\n                                    </circle>\n                                </g>\n                            </svg>\n                        </div>\n                        <div class=\"mt-2 flex justify-between mt-mono text-[9px] uppercase tracking-[.08em] text-[var(--mt-muted)]\" data-kid=\"1-1-3-3-1-2-2\" data-name=\"patterns x axis labels container\">\n                            <span data-dynamic=\"true\" data-kid=\"1-1-3-3-1-2-2-1\" data-name=\"start date display\" data-reason=\"text updated by tab selection script\" id=\"pattern-start\">\n                                AUG 26\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-1-3-3-1-2-2-2\" data-name=\"end date display\" data-reason=\"text updated by tab selection script\" id=\"pattern-end\">\n                                SEP 01\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-5 px-5\" data-kid=\"1-1-3-4\" data-name=\"patterns footer info\">\n                <p class=\"border-t border-[var(--mt-teal)] pt-3 text-[12px] leading-5 text-[var(--mt-faint-ink)]\" data-kid=\"1-1-3-4-1\" data-name=\"patterns descriptive text\">\n                    Mood labels describe your check-ins, not a score.\n                </p>\n                <p class=\"mt-4 mt-mono text-[10px] uppercase tracking-[.08em] text-[var(--mt-muted)]\" data-kid=\"1-1-3-4-2\" data-name=\"patterns helper message\" id=\"pattern-helper\">\n                    Record 3 days to begin a trace\n                </p>\n            </div>\n        </section>\n        <section class=\"mt-14 px-5 pb-4 scroll-mt-4\" data-kid=\"1-1-4\" data-name=\"reminders section\" id=\"reminders\">\n            <div class=\"border-t border-[var(--mt-teal)] pt-4\" data-kid=\"1-1-4-1\" data-name=\"reminders content wrapper\">\n                <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-1-4-1-1\" data-name=\"reminders section header\">\n                    <div data-kid=\"1-1-4-1-1-1\" data-name=\"reminders title container\">\n                        <p class=\"mt-mono text-[9px] uppercase tracking-[.15em] text-[var(--mt-teal)]\" data-kid=\"1-1-4-1-1-1-1\" data-name=\"reminders label\">\n                            Reminders / quiet prompt\n                        </p>\n                        <h2 class=\"mt-2 text-[25px] font-semibold leading-none tracking-[-.05em]\" data-kid=\"1-1-4-1-1-1-2\" data-name=\"reminders section heading\">\n                            Reminders\n                        </h2>\n                    </div>\n                    <i aria-hidden=\"true\" class=\"ti ti-bell-ringing shrink-0 text-[var(--mt-teal)]\" data-kid=\"1-1-4-1-1-2\" data-name=\"bell icon\" style=\"color:var(--mt-teal);width:22px;height:22px;font-size:22px;line-height:22px\">\n                    </i>\n                </div>\n                <div class=\"mt-5 border-y border-[var(--mt-teal)]\" data-kid=\"1-1-4-1-2\" data-name=\"reminders settings list\">\n                    <div class=\"flex min-h-[62px] items-center justify-between gap-4 border-b border-[var(--mt-soft-rule)]\" data-kid=\"1-1-4-1-2-1\" data-name=\"daily reminder row\">\n                        <div data-kid=\"1-1-4-1-2-1-1\" data-name=\"reminder text container\">\n                            <p class=\"text-[15px]\" data-kid=\"1-1-4-1-2-1-1-1\">\n                                Daily reminder\n                            </p>\n                            <p class=\"mt-1 mt-mono text-[9px] uppercase tracking-[.1em] text-[var(--mt-muted)]\" data-kid=\"1-1-4-1-2-1-1-2\">\n                                one check-in each day\n                            </p>\n                        </div>\n                        <button aria-pressed=\"true\" class=\"reminder-toggle h-8 min-w-[48px] border border-[var(--mt-teal)] px-2 mt-mono text-[10px] uppercase tracking-[.1em] text-[var(--mt-teal)]\" data-dynamic=\"true\" data-kid=\"1-1-4-1-2-1-2\" data-name=\"reminder toggle button\" data-reason=\"text/status toggled by click script\" id=\"reminder-toggle\" type=\"button\">\n                            On\n                        </button>\n                    </div>\n                    <div class=\"flex min-h-[62px] items-center justify-between gap-4\" data-kid=\"1-1-4-1-2-2\" data-name=\"time reminder row\">\n                        <span class=\"text-[15px]\" data-kid=\"1-1-4-1-2-2-1\">\n                            Time\n                        </span>\n                        <span class=\"mt-mono text-[14px] tracking-[.02em] text-[var(--mt-teal)]\" data-kid=\"1-1-4-1-2-2-2\">\n                            8:30 PM\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <nav aria-label=\"Today view sections\" class=\"fixed inset-x-0 bottom-0 z-50 border-t border-[var(--mt-teal)] bg-[var(--mt-paper)]\" data-kid=\"1-2\" data-name=\"bottom navigation bar\">\n        <div class=\"mx-auto flex h-[74px] max-w-[375px] items-stretch px-2\" data-kid=\"1-2-1\" data-name=\"nav inner layout\">\n            <button class=\"nav-item is-active relative flex min-w-0 flex-1 flex-col items-center justify-center gap-2 mt-mono text-[10px] uppercase tracking-[.05em]\" data-jump=\"today\" data-kid=\"1-2-1-1\" data-name=\"today nav item button\" type=\"button\">\n                <span class=\"nav-marker absolute top-0 h-[2px] w-5 bg-[var(--mt-coral)]\" data-kid=\"1-2-1-1-1\" data-name=\"nav active marker\">\n                </span>\n                <span aria-hidden=\"true\" class=\"h-[18px] w-[18px]\" data-kid=\"1-2-1-1-2\">\n                </span>\n                <span data-kid=\"1-2-1-1-3\">\n                    Today\n                </span>\n            </button>\n            <button class=\"nav-item relative flex min-w-0 flex-1 flex-col items-center justify-center gap-2 text-[var(--mt-teal)] mt-mono text-[10px] uppercase tracking-[.05em]\" data-jump=\"record\" data-kid=\"1-2-1-2\" data-name=\"record nav item button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-calendar-range\" data-kid=\"1-2-1-2-1\" style=\"color:var(--mt-teal);width:18px;height:18px;font-size:18px;line-height:18px\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\">\n                    Record\n                </span>\n            </button>\n            <button class=\"nav-item relative flex min-w-0 flex-1 flex-col items-center justify-center gap-2 text-[var(--mt-teal)] mt-mono text-[10px] uppercase tracking-[.05em]\" data-jump=\"patterns\" data-kid=\"1-2-1-3\" data-name=\"patterns nav item button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-chart-no-axes-column-increasing\" data-kid=\"1-2-1-3-1\" style=\"color:var(--mt-teal);width:18px;height:18px;font-size:18px;line-height:18px\">\n                </i>\n                <span data-kid=\"1-2-1-3-2\">\n                    Patterns\n                </span>\n            </button>\n            <button class=\"nav-item relative flex min-w-0 flex-1 flex-col items-center justify-center gap-2 text-[var(--mt-teal)] mt-mono text-[10px] uppercase tracking-[.05em]\" data-jump=\"reminders\" data-kid=\"1-2-1-4\" data-name=\"reminders nav item button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-bell-ringing\" data-kid=\"1-2-1-4-1\" style=\"color:var(--mt-teal);width:18px;height:18px;font-size:18px;line-height:18px\">\n                </i>\n                <span data-kid=\"1-2-1-4-2\">\n                    Reminders\n                </span>\n            </button>\n        </div>\n    </nav>\n</div>\n<script>\n    (() => {\n    const root = document.getElementById('mood-trace');\n    if (!root) return;\n\n    const moodRows = root.querySelectorAll('.mood-row');\n    const confirmation = root.querySelector('#mood-confirmation');\n    moodRows.forEach((row) => {\n      row.addEventListener('click', () => {\n        moodRows.forEach((item) => {\n          const active = item === row;\n          item.classList.toggle('is-selected', active);\n          item.setAttribute('aria-pressed', String(active));\n          const mark = item.querySelector('.mood-mark');\n          const state = item.querySelector('.mood-state');\n          mark.hidden = !active;\n          state.hidden = !active;\n        });\n        confirmation.textContent = `Recorded as ${row.dataset.mood}.`;\n      });\n    });\n\n    const recordButton = root.querySelector('#record-button');\n    const recordLabel = root.querySelector('#record-label');\n    recordButton.addEventListener('click', () => {\n      recordLabel.textContent = 'Recorded';\n      recordButton.setAttribute('aria-label', 'Recorded');\n    });\n\n    const calendarReadoutDate = root.querySelector('#calendar-readout-date');\n    const calendarReadoutNote = root.querySelector('#calendar-readout-note');\n    root.querySelectorAll('.calendar-day').forEach((day) => {\n      day.addEventListener('click', () => {\n        root.querySelectorAll('.calendar-day').forEach((item) => item.classList.remove('is-selected'));\n        day.classList.add('is-selected');\n        calendarReadoutDate.textContent = day.dataset.day;\n        calendarReadoutNote.textContent = day.dataset.note;\n      });\n    });\n\n    const rangeStart = root.querySelector('#pattern-start');\n    const rangeEnd = root.querySelector('#pattern-end');\n    const ranges = { '7': ['AUG 26', 'SEP 01'], '30': ['AUG 03', 'SEP 01'], '3m': ['JUN 01', 'SEP 01'] };\n    root.querySelectorAll('.range-tab').forEach((tab) => {\n      tab.addEventListener('click', () => {\n        const range = tab.dataset.range;\n        root.querySelectorAll('.range-tab').forEach((item) => {\n          const active = item === tab;\n          item.classList.toggle('is-active', active);\n          item.setAttribute('aria-selected', String(active));\n        });\n        root.querySelectorAll('[data-plot]').forEach((plot) => { plot.hidden = plot.dataset.plot !== range; });\n        rangeStart.textContent = ranges[range][0];\n        rangeEnd.textContent = ranges[range][1];\n      });\n    });\n\n    const reminderToggle = root.querySelector('#reminder-toggle');\n    reminderToggle.addEventListener('click', () => {\n      const on = reminderToggle.getAttribute('aria-pressed') === 'true';\n      reminderToggle.setAttribute('aria-pressed', String(!on));\n      reminderToggle.textContent = on ? 'Off' : 'On';\n      reminderToggle.classList.toggle('is-off', on);\n    });\n\n    root.querySelectorAll('[data-jump]').forEach((item) => {\n      item.addEventListener('click', () => {\n        const target = root.querySelector(`#${item.dataset.jump}`);\n        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });\n        root.querySelectorAll('.nav-item').forEach((navItem) => navItem.classList.remove('is-active'));\n        item.classList.add('is-active');\n      });\n    });\n  })();\n</script>\n",
