rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/reflections/{reflectionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read so unauthenticated sign-in can resolve a username to its account.
    // Only the owning, newly-authenticated user may create their own mapping, and it can't be reassigned.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }
  }
}
