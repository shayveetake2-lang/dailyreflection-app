rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId}/reflections/{reflectionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Profile mirror (username/email) used for the account's own display name and the admin panel listing.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    // Public read so unauthenticated sign-in can resolve a username to its account.
    // Only the owning, newly-authenticated user may create their own mapping, and it can't be reassigned.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    // Marks a uid as an admin. The very first admin may self-claim once (see meta/adminBootstrap);
    // after that, only existing admins may promote/demote others.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid
          && !exists(/databases/$(database)/documents/meta/adminBootstrap)
        )
      );
      allow delete: if isAdmin() && request.auth.uid != uid;
      allow update: if false;
    }

    // Created once, atomically alongside the first admins/{uid} doc, to close the self-claim window for good.
    match /meta/adminBootstrap {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.completed == true;
      allow update, delete: if false;
    }
  }
}

